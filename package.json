{
  "name": "melcoed-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "todos": "grep -rnE \"TODO|<Todo|todo: (true|.)\" src --include=*.astro --include=*.ts | grep -v \"src/components/Todo.astro\"",
    "checklist": "node scripts/content-checklist.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/yellowtail": "^5.3.0",
    "astro": "^7.4.2"
  }
}
