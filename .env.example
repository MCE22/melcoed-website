# Copy to .env for local dev. In Cloudflare Pages set these under
# Settings > Environment variables (Production and Preview), then redeploy.
# PUBLIC_ variables are inlined into the HTML at build time; the Web3Forms
# access key is designed to be public (it only allows sending to its owner's inbox).

# Web3Forms access key, created at web3forms.com using quotes@melcoed.com
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Set to "true" only with a Web3Forms Pro plan (file attachments are Pro-only).
PUBLIC_WEB3FORMS_FILE_UPLOADS=false
