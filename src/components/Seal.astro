---
// Round seal: the official image (src/assets/brand/mce-seal.png), WebP with a PNG fallback.
// The seal stands in for the old separate Made-in badge, so `mark="madeIn"` renders nothing.
import { Picture } from 'astro:assets';
import { sealPng, brandAlt } from '../data/brand';

interface Props {
  mark?: 'seal' | 'madeIn';
  class?: string;
  size?: number;
}
const { mark = 'seal', class: className, size = 400 } = Astro.props;
---

{
  mark === 'seal' && (
    <Picture pictureAttributes={{ class: ['seal', className].filter(Boolean).join(' ') }} src={sealPng} formats={['webp']} fallbackFormat="png" widths={[size, size * 2].filter((w) => w <= sealPng.width)} sizes={`${size}px`} alt={brandAlt} loading="lazy" />
  )
}
<style>
  :global(picture.seal) {
    display: block;
    width: 100%;
  }
  .seal,
  :global(picture.seal) img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 3px rgb(27 24 21 / 0.3)) drop-shadow(0 6px 10px rgb(27 24 21 / 0.12));
  }
</style>
