---
// Round seal. Uses the official image (src/assets/brand/mce-seal.png) when present,
// as WebP with a PNG fallback; otherwise the generated SVG seal or Made-in badge.
// With the official seal in place, the separate Made-in badge is not shown (the seal
// stands in for both), so callers that render both end up with a single seal.
import { Picture } from 'astro:assets';
import { brand, sealPng, brandAlt } from '../data/brand';

interface Props {
  mark?: 'seal' | 'madeIn';
  class?: string;
  size?: number;
}
const { mark = 'seal', class: className, size = 400 } = Astro.props;
const m = brand[mark];
---

{
  sealPng ? (
    mark === 'seal' && (
      <Picture pictureAttributes={{ class: ['seal', className].filter(Boolean).join(' ') }} src={sealPng} formats={['webp']} fallbackFormat="png" widths={[size, size * 2].filter((w) => w <= sealPng.width)} sizes={`${size}px`} alt={brandAlt} loading="lazy" />
    )
  ) : (
    <img class:list={['seal', className]} src={m.src} width={size} height={size} alt={m.alt} loading="lazy" decoding="async" />
  )
}

<style>
  :global(picture.seal) {
    display: block;
    width: 100%;
  }
  .seal,
  :global(picture.seal) img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 3px rgb(27 24 21 / 0.3)) drop-shadow(0 6px 10px rgb(27 24 21 / 0.12));
  }
</style>
