---
// Round brass seal (secondary mark) or the Made-in badge. Files from src/data/brand.ts.
import { brand } from '../data/brand';

interface Props {
  mark?: 'seal' | 'madeIn';
  class?: string;
  size?: number;
}
const { mark = 'seal', class: className, size = 400 } = Astro.props;
const m = brand[mark];
---

<img class:list={['seal', className]} src={m.src} width={size} height={size} alt={m.alt} loading="lazy" decoding="async" />

<style>
  .seal {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 14px rgb(27 24 21 / 0.28));
  }
</style>
