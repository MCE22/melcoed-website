---
import { brandAlt } from '../data/brand';

interface Props {
  variant?: 'compact' | 'primary';
  width?: number;
  link?: boolean;
  eager?: boolean;
}
const { width = 180, link = true, eager = true } = Astro.props;
const Tag = link ? 'a' : 'span';
---
<Tag class="logo" href={link ? '/' : undefined} aria-label={link ? 'Mel-Co-Ed home' : undefined}>
  <img src="/brand/wordmark.svg" width={265} height={50} style={`width:${width}px`} alt={brandAlt} loading={eager ? 'eager' : 'lazy'} />
</Tag>
<style>
  .logo { display: inline-block; vertical-align: middle; flex: none; line-height: 0; }
  img { display: block; max-width: 100%; height: auto; }
</style>
