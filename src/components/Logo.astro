---
// Brass plate logo. Files and sizes come from src/data/brand.ts, so swapping the
// generated SVG for a photo of a real struck plate is a one-line change there.
import { brand } from '../data/brand';

interface Props {
  variant?: 'compact' | 'primary';
  /** Rendered width in px (height follows the mark's proportions). */
  width?: number;
  link?: boolean;
  eager?: boolean;
}
const { variant = 'compact', width = 150, link = true, eager = true } = Astro.props;
const mark = variant === 'primary' ? brand.plate : brand.plateCompact;
const height = Math.round((width * mark.height) / mark.width);
const img = { src: mark.src, width, height, alt: link ? `${mark.alt} home` : mark.alt };
---

{
  link ? (
    <a href="/" class="logo" aria-label={img.alt}>
      <img {...img} alt="" decoding="async" loading={eager ? 'eager' : 'lazy'} />
    </a>
  ) : (
    <img class="logo" {...img} decoding="async" loading={eager ? 'eager' : 'lazy'} />
  )
}

<style>
  .logo {
    display: inline-block;
    flex: none;
    line-height: 0;
  }
  .logo img,
  img.logo {
    width: auto;
    height: auto;
    max-width: 100%;
    filter: drop-shadow(0 2px 3px rgb(27 24 21 / 0.25));
  }
</style>
