---
// Script wordmark modeled on the vintage sign.
// TODO: replace with a vector trace of the actual sign logo (SVG) once supplied;
// keep the <a> wrapper and aria-label so header/footer don't need changes.
interface Props {
  tone?: 'red' | 'cream';
  size?: 'md' | 'lg';
}
const { tone = 'red', size = 'md' } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${tone}`, `logo--${size}`]} aria-label="Mel-Co-Ed, Inc. home">
  <span class="logo__script" aria-hidden="true">Mel-Co-Ed</span>
  <span class="logo__inc" aria-hidden="true">Inc.</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.3rem;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
  }
  .logo__script {
    font-family: var(--font-script);
    font-size: 2.1rem;
    line-height: 0.9;
    padding-bottom: 0.18em;
    /* Sign-style swash underline */
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 2px no-repeat;
  }
  .logo__inc {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-bottom: 0.7em;
  }
  .logo--lg .logo__script {
    font-size: 3rem;
  }
  .logo--red {
    color: var(--cherry);
  }
  .logo--red:hover {
    color: var(--cherry-600);
  }
  .logo--cream,
  .logo--cream:hover {
    color: var(--cream);
  }
  @media (min-width: 48rem) {
    .logo__script {
      font-size: 2.5rem;
    }
    .logo--lg .logo__script {
      font-size: 3.5rem;
    }
  }
</style>
