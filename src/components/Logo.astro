---
// Plate logo. Uses the official image (src/assets/brand/mce-plate.png) when present,
// served as WebP with a PNG fallback; otherwise the generated SVG plate.
import { Picture } from 'astro:assets';
import { brand, platePng, brandAlt } from '../data/brand';

interface Props {
  variant?: 'compact' | 'primary';
  /** Largest rendered width in px (CSS may show it smaller; height follows proportions). */
  width?: number;
  link?: boolean;
  eager?: boolean;
}
const { variant = 'compact', width = 150, link = true, eager = true } = Astro.props;
const svg = variant === 'primary' ? brand.plate : brand.plateCompact;
const svgHeight = Math.round((width * svg.height) / svg.width);
const loading = eager ? 'eager' : 'lazy';
---

{
  platePng ? (
    link ? (
      <a href="/" class="logo">
        <Picture src={platePng} formats={['webp']} fallbackFormat="png" widths={[width, width * 2].filter((w) => w <= platePng.width)} sizes={`${width}px`} alt={`${brandAlt} (home)`} loading={loading} />
      </a>
    ) : (
      <span class="logo">
        <Picture src={platePng} formats={['webp']} fallbackFormat="png" widths={[width, width * 2].filter((w) => w <= platePng.width)} sizes={`${width}px`} alt={brandAlt} loading={loading} />
      </span>
    )
  ) : link ? (
    <a href="/" class="logo" aria-label={`${svg.alt} home`}>
      <img src={svg.src} width={width} height={svgHeight} alt="" decoding="async" loading={loading} />
    </a>
  ) : (
    <img class="logo" src={svg.src} width={width} height={svgHeight} alt={svg.alt} decoding="async" loading={loading} />
  )
}

<style>
  .logo {
    display: inline-block;
    flex: none;
    line-height: 0;
  }
  .logo :global(img),
  img.logo {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 3px rgb(27 24 21 / 0.25));
  }
</style>
