---
import Logo from './Logo.astro';
import { site, nav, quoteHref } from '../data/site';
import { isLive, liveLinks } from '../lib/routes';

const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && !href.includes('#') && path.startsWith(href);

// Hide links to pages that don't exist yet; drop a dropdown entirely if none of its pages exist.
const items = nav
  .map((item) => (item.children ? { ...item, children: liveLinks(item.children) } : item))
  .filter((item) => (item.children ? item.children.length > 0 : isLive(item.href)));
---

<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar__inner">
      <span class="topbar__since">Family-owned &middot; Pawtucket, R.I. &middot; Since {site.foundingYear}</span>
      <a class="topbar__phone" href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
    </div>
  </div>

  <div class="mainbar">
    <div class="wrap mainbar__inner">
      <Logo />

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-toggle__bars" aria-hidden="true"></span>
        <span class="visually-hidden">Menu</span>
      </button>

      <nav id="site-nav" class="nav" aria-label="Main">
        <ul class="nav__list">
          {
            items.map((item, i) =>
              item.children ? (
                <li class="nav__item nav__item--has-sub">
                  <button class="nav__link nav__sub-toggle" type="button" aria-expanded="false" aria-controls={`nav-sub-${i}`}>
                    {item.label}
                    <svg class="nav__caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                      <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                  </button>
                  <ul id={`nav-sub-${i}`} class="nav__sub">
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li class="nav__item">
                  <a class="nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ),
            )
          }
        </ul>
        <a class="btn btn--primary nav__cta" href={quoteHref}>Request a Quote</a>
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu + Products submenu. Progressive enhancement: without JS the
  // desktop submenu still opens on hover/focus, and every link exists in the footer.
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const subToggles = [...(header?.querySelectorAll<HTMLButtonElement>('.nav__sub-toggle') ?? [])];

  const setOpen = (btn: HTMLButtonElement | null | undefined, open: boolean) => {
    if (!btn) return;
    btn.setAttribute('aria-expanded', String(open));
  };
  const isOpen = (btn: HTMLButtonElement) => btn.getAttribute('aria-expanded') === 'true';

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setOpen(toggle, open);
    document.documentElement.classList.toggle('nav-open', open);
  });

  for (const btn of subToggles) {
    btn.addEventListener('click', () => {
      const open = !isOpen(btn);
      // One dropdown at a time
      for (const other of subToggles) setOpen(other, false);
      setOpen(btn, open);
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const btn of subToggles) setOpen(btn, false);
    if (toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(toggle, false);
      document.documentElement.classList.remove('nav-open');
      toggle.focus();
    }
  });

  document.addEventListener('click', (e) => {
    for (const btn of subToggles) {
      if (!btn.parentElement?.contains(e.target as Node)) setOpen(btn, false);
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  /* Utility bar */
  .topbar {
    background: var(--navy);
    color: var(--cream-200);
    font-size: 0.8rem;
  }
  .topbar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 2.1rem;
  }
  .topbar__since {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .topbar__phone {
    color: var(--cream-100);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    white-space: nowrap;
  }
  .topbar__phone:hover {
    color: var(--robin);
    text-decoration: underline;
  }

  /* Main bar: off-white with a double chrome pinstripe beneath */
  .mainbar {
    background: var(--paper);
    border-bottom: 1px solid var(--chrome);
    box-shadow:
      0 3px 0 var(--paper),
      0 4px 0 var(--chrome),
      0 12px 20px -18px rgb(19 30 49 / 0.5);
  }
  .mainbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    gap: 1rem;
  }

  /* Mobile toggle */
  .menu-toggle {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-right: -0.5rem;
    border: 0;
    background: none;
    color: var(--navy);
    cursor: pointer;
  }
  .menu-toggle__bars,
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    display: block;
    width: 1.5rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .menu-toggle__bars {
    position: relative;
  }
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu-toggle__bars::before {
    top: -7px;
  }
  .menu-toggle__bars::after {
    top: 7px;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
    background: transparent;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Nav — mobile panel */
  .nav {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 4px);
    max-height: calc(100dvh - var(--header-h) - 2.1rem);
    overflow-y: auto;
    padding: 0.5rem var(--gutter) 1.5rem;
    background: var(--paper);
    border-bottom: 1px solid var(--chrome);
    box-shadow: 0 24px 30px -20px rgb(19 30 49 / 0.45);
    /* slide/fade open; display transitions discretely so closing animates too */
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      display var(--dur) allow-discrete;
  }
  :global(html.nav-open) .nav {
    display: block;
    opacity: 1;
    transform: none;
  }
  @starting-style {
    :global(html.nav-open) .nav {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .nav__list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .nav__item {
    border-bottom: 1px solid var(--chrome-light);
  }
  .nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.95rem 0;
    border: 0;
    background: none;
    color: var(--navy);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--cherry);
  }
  .nav__caret {
    transition: transform var(--dur) var(--ease);
  }
  .nav__sub-toggle[aria-expanded='true'] .nav__caret {
    transform: rotate(180deg);
  }
  .nav__sub {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0 0 0.75rem 0.9rem;
    border-left: 2px solid var(--chrome);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      display var(--dur-fast) allow-discrete;
  }
  .nav__sub-toggle[aria-expanded='true'] + .nav__sub {
    display: block;
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .nav__sub-toggle[aria-expanded='true'] + .nav__sub {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .nav__sub a {
    display: block;
    padding: 0.5rem 0;
    color: var(--ink-600);
    font-weight: 500;
    text-decoration: none;
  }
  .nav__sub a:hover,
  .nav__sub a[aria-current='page'] {
    color: var(--cherry);
  }
  .nav__cta {
    width: 100%;
  }

  /* Nav — desktop */
  @media (min-width: 72rem) {
    .menu-toggle {
      display: none;
    }
    .nav {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      position: static;
      max-height: none;
      overflow: visible;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: none;
      opacity: 1;
      transform: none;
      transition: none;
    }
    .nav__list {
      display: flex;
      gap: 1.6rem;
      margin: 0;
    }
    .nav__item {
      position: relative;
      border: 0;
    }
    .nav__link {
      gap: 0.4rem;
      padding: 0.5rem 0;
      font-size: 0.82rem;
      background: linear-gradient(var(--cherry), var(--cherry)) left bottom / 0 2px no-repeat;
      transition: background-size var(--dur) var(--ease), color var(--dur-fast) var(--ease);
    }
    .nav__link:hover,
    .nav__link[aria-current='page'] {
      background-size: 100% 2px;
    }
    .nav__sub {
      position: absolute;
      top: calc(100% + 0.25rem);
      left: -1rem;
      min-width: 16rem;
      padding: 0.5rem;
      background: var(--paper);
      border: 1px solid var(--chrome-light);
      border-radius: 12px;
      box-shadow: var(--shadow);
    }
    .nav__item--has-sub:hover .nav__sub,
    .nav__item--has-sub:focus-within .nav__sub {
      display: block;
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .nav__item--has-sub:hover .nav__sub,
      .nav__item--has-sub:focus-within .nav__sub {
        opacity: 0;
        transform: translateY(-4px);
      }
    }
    /* hover bridge so the menu doesn't close in the gap */
    .nav__item--has-sub::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 0.5rem;
    }
    .nav__sub a {
      padding: 0.55rem 0.75rem;
      border-radius: 8px;
    }
    .nav__sub a:hover {
      background: var(--cream-100);
    }
    .nav__cta {
      width: auto;
      white-space: nowrap;
      min-height: 2.6rem;
      padding: 0.6rem 1.1rem;
      font-size: 0.8rem;
    }
  }
</style>
