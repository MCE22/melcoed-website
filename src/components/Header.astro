---
import Logo from './Logo.astro';
import { site, nav, quoteHref } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => path === href.replace(/\/$/, '') ? 'page' : undefined;
---
<header class="masthead">
  <div class="utility">
    <div class="wrap">
      <span>Pawtucket, Rhode Island <b aria-hidden="true">/</b> <span class="est">Est. 1948</span></span>
      <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
    </div>
  </div>
  <div class="wrap main-bar">
    <Logo width={196} />
    <nav class="wide-nav" aria-label="Main">
      {nav.map(item => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
    </nav>
    <a href="/search/" class="search-link" aria-label="Search the website">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10" cy="10" r="6.3"/><path d="m15 15 6 6"/></svg>
    </a>
    <a class="btn btn--primary quote" href={quoteHref}>Request a quote <span aria-hidden="true">↗</span></a>
    <details class="menu">
      <summary>Menu <svg width="16" height="14" viewBox="0 0 16 14" aria-hidden="true"><path d="M0 3h16M0 10h16" stroke="currentColor" stroke-width="2"/></svg></summary>
      <nav aria-label="Mobile navigation">
        {[...nav, { label: 'Request a quote', href: quoteHref }, { label: 'Search', href: '/search/' }, { label: 'Contact', href: '/contact/' }].map(item =>
          <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.masthead .menu');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
<style>
  .masthead { position: relative; z-index: 20; background: var(--cream); border-bottom: 1px solid var(--rule); }
  .utility { background: var(--navy); color: var(--cream); }
  .utility .wrap { min-height: 31px; display:flex; justify-content: space-between; align-items: center; gap: .5rem; font: 600 .69rem/1.3 var(--font-body); letter-spacing: .09em; text-transform: uppercase; }
  .utility b { color: var(--brass-light); margin: 0 .5rem; }
  .utility a { color: inherit; text-decoration: none; letter-spacing: .055em; }
  .main-bar { display: flex; align-items:center; gap: clamp(.65rem, 2vw, 1.9rem); height: clamp(66px, 7vw, 89px); }
  .main-bar :global(.logo) { width: clamp(126px, 15vw, 196px); margin-right: auto; }
  .wide-nav { display: flex; align-items: center; gap: clamp(1rem,1.8vw,2rem); }
  nav a, summary { font: 620 .875rem/1.3 var(--font-body); color: var(--ink); text-decoration: none; }
  nav a:hover, nav a[aria-current], summary:hover { color: var(--oxblood); }
  nav a[aria-current] { text-decoration: underline; text-underline-offset: .4rem; }
  .search-link { display: grid; place-items: center; width: 40px; height: 44px; color: var(--ink); }
  .quote { font-size: .84rem; min-height: 43px; padding: .75rem 1.2rem; }
  .menu { display:none; }
  summary { min-height: 44px; display:flex; list-style: none; gap:.55rem; align-items:center; cursor:pointer; }
  summary::-webkit-details-marker { display:none; }
  .menu::details-content { transition: none; }
  .menu nav { position:absolute; top:100%; left:0; right:0; background: var(--paper); border-bottom: 2px solid var(--navy); padding: .7rem var(--gutter) 1rem; box-shadow: 0 18px 22px -20px #0c1724; }
  .menu nav a { display:block; padding:.75rem .25rem; border-bottom:1px solid var(--rule); }
  @media (max-width:62rem) { .menu { display:block; } .wide-nav,.search-link {display:none;} }
  @media (max-width:32rem) { .main-bar { gap:.8rem; } .quote { padding:.65rem .75rem; font-size:.78rem; min-height:40px; } .quote span {display:none;} }
  @media (max-width:30rem) { .est,.utility b {display:none;} .utility a {white-space:nowrap;} }
  @media (max-width:22rem) { .main-bar :global(.logo) { width:110px; } .main-bar {gap:.6rem;} .est,.utility b {display:none;} }
</style>
