---
import Logo from './Logo.astro';
import { site, nav, quoteHref } from '../data/site';
import { isLive, liveLinks } from '../lib/routes';

const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && !href.includes('#') && path.startsWith(href);

// Hide links to pages that don't exist yet; drop a dropdown entirely if none of its pages exist.
const items = nav
  .map((item) => (item.children ? { ...item, children: liveLinks(item.children) } : item))
  .filter((item) => (item.children ? item.children.length > 0 : isLive(item.href)));
const hasSearch = isLive('/search/');
---

<header class="site-header">
  <div class="wrap bar">
    <p class="est" aria-hidden="true">Est. {site.foundingYear}<br />{site.address.city}, {site.address.region}</p>

    <Logo width={290} />

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav__list">
        {
          items.map((item, i) =>
            item.children ? (
              <li class="nav__item nav__item--has-sub">
                <button class="nav__link nav__sub-toggle" type="button" aria-expanded="false" aria-controls={`nav-sub-${i}`}>
                  {item.label}
                  <svg class="nav__caret" viewBox="0 0 10 6" width="9" height="6" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </button>
                <ul id={`nav-sub-${i}`} class="nav__sub">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav__item">
                <a class="nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      {
        hasSearch && (
          <a class="icon-btn nav__search" href="/search/" aria-label="Search the site">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
            </svg>
          </a>
        )
      }
      <a class="nav__phone" href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
      <a class="btn btn--primary nav__cta" href={quoteHref}>Request a Quote <span class="arr" aria-hidden="true">→</span></a>
    </nav>

    <div class="tools">
      {
        hasSearch && (
          <a class="icon-btn tools__search" href="/search/" aria-label="Search the site">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
            </svg>
          </a>
        )
      }
      <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-toggle__bars" aria-hidden="true"></span>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile menu + dropdowns. Progressive enhancement: without JS the desktop
  // dropdowns still open on hover/focus, and every link exists in the footer.
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const subToggles = [...(header?.querySelectorAll<HTMLButtonElement>('.nav__sub-toggle') ?? [])];

  const setOpen = (btn: HTMLButtonElement | null | undefined, open: boolean) => {
    if (!btn) return;
    btn.setAttribute('aria-expanded', String(open));
  };
  const isOpen = (btn: HTMLButtonElement) => btn.getAttribute('aria-expanded') === 'true';

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setOpen(toggle, open);
    document.documentElement.classList.toggle('nav-open', open);
  });

  for (const btn of subToggles) {
    btn.addEventListener('click', () => {
      const open = !isOpen(btn);
      for (const other of subToggles) setOpen(other, false);
      setOpen(btn, open);
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const btn of subToggles) setOpen(btn, false);
    if (toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(toggle, false);
      document.documentElement.classList.remove('nav-open');
      toggle.focus();
    }
  });

  document.addEventListener('click', (e) => {
    for (const btn of subToggles) {
      if (!btn.parentElement?.contains(e.target as Node)) setOpen(btn, false);
    }
  });

  // Condense the header (smaller plate) once the page has scrolled a little.
  let ticking = false;
  const condense = () => {
    ticking = false;
    header?.classList.toggle('is-condensed', window.scrollY > 40);
  };
  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(condense);
      }
    },
    { passive: true },
  );
  condense();

  // Publish the header's live height (it changes when condensed) for sticky offsets
  // and anchor scroll padding elsewhere: var(--header-live).
  if (header) {
    new ResizeObserver(([entry]) => {
      document.documentElement.style.setProperty('--header-live', `${Math.round(entry.borderBoxSize[0].blockSize)}px`);
    }).observe(header);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--cream) 94%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  /* the header runs a little wider than body content so the large plate, nav and CTA fit */
  .bar.wrap {
    max-width: 92rem;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  /* Plate is the hero of the header; it eases to a compact size once the page scrolls. */
  .bar :global(.logo) {
    width: 188px;
    padding-block: 0.6rem;
    transition:
      width var(--dur) var(--ease),
      padding var(--dur) var(--ease);
  }
  @media (min-width: 48rem) {
    .bar :global(.logo) {
      width: 240px;
    }
  }
  @media (min-width: 80rem) {
    .bar :global(.logo) {
      width: 290px;
      padding-block: 0.75rem;
    }
  }
  :global(.site-header.is-condensed) .bar :global(.logo) {
    width: 140px;
    padding-block: 0.45rem;
  }
  @media (min-width: 80rem) {
    :global(.site-header.is-condensed) .bar :global(.logo) {
      width: 180px;
    }
  }

  .est {
    display: none;
    margin: 0;
    padding-right: 1.5rem;
    border-right: 1px solid var(--rule);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--brass-text);
    white-space: nowrap;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }
  .icon-btn:hover {
    color: var(--oxblood);
  }
  .menu-toggle {
    margin-right: -0.6rem;
  }
  .menu-toggle__bars,
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    display: block;
    width: 1.4rem;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .menu-toggle__bars {
    position: relative;
  }
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu-toggle__bars::before {
    top: -6px;
  }
  .menu-toggle__bars::after {
    top: 6px;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
    background: transparent;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Nav: mobile panel */
  .nav {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100dvh - var(--header-live, var(--header-h)));
    overflow-y: auto;
    padding: 0.5rem var(--gutter) 1.75rem;
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      display var(--dur) allow-discrete;
  }
  :global(html.nav-open) .nav {
    display: block;
    opacity: 1;
    transform: none;
  }
  @starting-style {
    :global(html.nav-open) .nav {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .nav__list {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .nav__item {
    border-bottom: 1px solid var(--rule);
  }
  .nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1rem 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--oxblood);
  }
  .nav__caret {
    transition: transform var(--dur) var(--ease);
  }
  .nav__sub-toggle[aria-expanded='true'] .nav__caret {
    transform: rotate(180deg);
  }
  .nav__sub {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0 0 0.9rem 1rem;
    border-left: 1px solid var(--brass);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      display var(--dur-fast) allow-discrete;
  }
  .nav__sub-toggle[aria-expanded='true'] + .nav__sub {
    display: block;
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .nav__sub-toggle[aria-expanded='true'] + .nav__sub {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .nav__sub a {
    display: block;
    padding: 0.5rem 0;
    color: var(--ink-600);
    text-decoration: none;
  }
  .nav__sub a:hover,
  .nav__sub a[aria-current='page'] {
    color: var(--oxblood);
  }
  .nav__phone {
    display: block;
    margin-bottom: 1rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-decoration: none;
  }
  .nav__cta {
    width: 100%;
  }

  /* Desktop */
  @media (min-width: 80rem) {
    .bar {
      gap: 2rem;
    }
    .nav {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      position: static;
      flex: 1;
      justify-content: flex-end;
      max-height: none;
      overflow: visible;
      padding: 0;
      border: 0;
      background: none;
      opacity: 1;
      transform: none;
      transition: none;
    }
    .nav__list {
      display: flex;
      gap: 1.6rem;
      margin: 0;
    }
    .nav__item {
      position: relative;
      border: 0;
    }
    .nav__link {
      gap: 0.45rem;
      padding: 0.6rem 0;
      font-size: 0.7rem;
      background: linear-gradient(var(--brass), var(--brass)) left bottom / 0 1px no-repeat;
      transition:
        background-size var(--dur) var(--ease),
        color var(--dur-fast) var(--ease);
    }
    .nav__link:hover,
    .nav__link[aria-current='page'] {
      background-size: 100% 1px;
    }
    .nav__sub {
      position: absolute;
      top: calc(100% + 0.6rem);
      left: -1.25rem;
      min-width: 16rem;
      padding: 0.6rem 0;
      background: var(--paper);
      border: 1px solid var(--rule);
      border-top: 1px solid var(--brass);
      box-shadow: 0 18px 30px -24px rgb(27 24 21 / 0.45);
    }
    .nav__item--has-sub::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 0.8rem;
    }
    .nav__item--has-sub:hover .nav__sub,
    .nav__item--has-sub:focus-within .nav__sub {
      display: block;
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .nav__item--has-sub:hover .nav__sub,
      .nav__item--has-sub:focus-within .nav__sub {
        opacity: 0;
        transform: translateY(-4px);
      }
    }
    .nav__sub a {
      padding: 0.55rem 1.25rem;
      font-size: 0.92rem;
    }
    .nav__sub a:hover {
      background: var(--cream);
    }
    .nav__phone {
      display: none;
    }
    .nav__cta {
      width: auto;
      min-height: 2.75rem;
      padding: 0.7rem 1.15rem;
      font-size: 0.66rem;
      white-space: nowrap;
    }
    .tools {
      display: none;
    }
  }
  .nav__search {
    display: none;
  }
  @media (min-width: 80rem) {
    .nav__search {
      display: grid;
      margin-right: -0.75rem;
    }
  }
  @media (min-width: 90rem) {
    .est {
      display: block;
    }
  }
</style>
