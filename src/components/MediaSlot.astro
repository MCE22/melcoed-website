---
// One photo from a slot in src/data/photos.ts, cropped to a fixed aspect ratio.
// Built for dark, moody product shots: the frame is dark, and `fade` blends the
// photo's edge into the page background. An empty slot shows a dark placeholder
// with a small TODO tag, so layouts look right before photography exists.
import { Image } from 'astro:assets';
import Todo from './Todo.astro';
import { photos, type PhotoSlotName } from '../data/photos';

interface Props {
  slot: PhotoSlotName;
  index?: number;
  /** CSS aspect-ratio, e.g. "4 / 5". Omit to fill the parent's height. */
  aspect?: string;
  sizes?: string;
  eager?: boolean;
  /** Fade the photo into the background on this side. */
  fade?: 'left' | 'bottom' | 'none';
  /** Short note shown on the placeholder while the slot is empty. */
  todo: string;
  class?: string;
}
const { slot, index = 0, aspect, sizes = '(min-width: 64rem) 50vw, 100vw', eager = false, fade = 'none', todo, class: className } = Astro.props;
const photo = photos[slot]?.[index];
const widths = [480, 800, 1200, 1600, 2000];
---

<figure class:list={['media', `media--fade-${fade}`, className]} style={aspect ? `aspect-ratio:${aspect}` : undefined}>
  {
    photo ? (
      <Image
        src={photo.src}
        alt={photo.alt}
        widths={widths.filter((w) => w <= photo.src.width)}
        sizes={sizes}
        format="webp"
        quality={80}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <div class="ph">
        <Todo>{todo} (slot <code>{slot}</code>)</Todo>
      </div>
    )
  }
</figure>

<style>
  .media {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: #14110e;
  }
  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media--fade-left {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 22%);
    mask-image: linear-gradient(to right, transparent 0, #000 22%);
  }
  .media--fade-bottom {
    -webkit-mask-image: linear-gradient(to top, transparent 0, #000 22%);
    mask-image: linear-gradient(to top, transparent 0, #000 22%);
  }
  .media .ph {
    position: absolute;
    inset: 0;
  }
  .media--fade-left .ph {
    place-items: end end;
    padding-left: 30%;
  }
  .media .ph :global(.todo) {
    font-size: 0.7rem;
  }
</style>
