---
import { Image } from 'astro:assets';
import { photos, isSpacer, type PhotoSlotName } from '../data/photos';

interface Props {
  slot: PhotoSlotName;
  index?: number;
  aspect?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** Accepted for existing callers; captions always appear inside the figure. */
  labelOutside?: boolean;
  fade?: 'left' | 'bottom' | 'none';
  todo?: string;
  tone?: 'charcoal' | 'cream';
}

const {
  slot,
  index = 0,
  aspect,
  sizes = '(min-width: 64rem) 50vw, 100vw',
  eager = false,
  class: className,
} = Astro.props;
const item = photos[slot]?.[index];
const photo = isSpacer(item) ? undefined : item;
const widths = [360, 600, 900, 1280, 1600, 2000];
---

{photo && (
  <figure class:list={['media', className]} style={aspect ? `aspect-ratio: ${aspect}` : undefined}>
    <Image
      src={photo.src}
      alt={photo.alt}
      widths={widths.filter((w) => w < photo.src.width).concat(Math.min(photo.src.width, 2040))}
      sizes={sizes}
      format="webp"
      quality={81}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
    {photo.illustration && <figcaption>Fictional design concept</figcaption>}
  </figure>
)}

<style>
  .media { position: relative; margin: 0; overflow: hidden; background: #211d19; }
  .media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  figcaption {
    position: absolute;
    inset: auto auto .65rem .65rem;
    max-width: calc(100% - 1.3rem);
    padding: .28rem .58rem;
    background: #201d1a;
    color: #faf6ee;
    font: 500 .78rem/1.4 var(--font-body, system-ui);
    letter-spacing: .02em;
    overflow-wrap: anywhere;
  }
</style>
