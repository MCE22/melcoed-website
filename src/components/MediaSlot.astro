---
// One photo from a slot in src/data/photos.ts, cropped to a fixed aspect ratio.
// Built for dark, moody product shots: the frame is dark, and `fade` blends the
// photo's edge into the page background. An empty slot shows a dark placeholder
// with a small TODO tag, so layouts look right before photography exists.
import { Image } from 'astro:assets';
import Todo from './Todo.astro';
import { photos, type PhotoSlotName } from '../data/photos';
import { confidential } from '../data/confidential';

interface Props {
  slot: PhotoSlotName;
  index?: number;
  /** CSS aspect-ratio, e.g. "4 / 5". Omit to fill the parent's height. */
  aspect?: string;
  sizes?: string;
  eager?: boolean;
  /** Fade the photo into the background on this side. */
  fade?: 'left' | 'bottom' | 'none';
  /** Short note shown on the placeholder while the slot is empty. */
  todo: string;
  class?: string;
  /** Skip the overlaid illustration label when the caller shows the label itself (small tiles). */
  labelOutside?: boolean;
}
const { labelOutside = false, slot, index = 0, aspect, sizes = '(min-width: 64rem) 50vw, 100vw', eager = false, fade = 'none', todo, class: className } = Astro.props;
const photo = photos[slot]?.[index];
const widths = [480, 800, 1200, 1600, 2000];
---

<figure class:list={['media', `media--fade-${fade}`, className]} style={aspect ? `aspect-ratio:${aspect}` : undefined}>
  {
    photo ? (
      <Image
        src={photo.src}
        alt={photo.alt}
        widths={widths.filter((w) => w <= photo.src.width)}
        sizes={sizes}
        format="webp"
        quality={80}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : null
  }
  {
    photo?.illustration && !labelOutside && (
      <figcaption class="media__illus">
        <strong>Illustration</strong>{confidential.illustrationLabel.replace(/^Illustration/, '')}
      </figcaption>
    )
  }
  {
    !photo && (
      <div class="ph">
        <Todo>{todo} (slot <code>{slot}</code>)</Todo>
      </div>
    )
  }
</figure>

<style>
  .media {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: #14110e;
  }
  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media--fade-left {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 22%);
    mask-image: linear-gradient(to right, transparent 0, #000 22%);
  }
  .media--fade-bottom {
    -webkit-mask-image: linear-gradient(to top, transparent 0, #000 22%);
    mask-image: linear-gradient(to top, transparent 0, #000 22%);
  }
  /* Visible label on illustrations, kept inside the un-faded part of the frame */
  .media__illus {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 22%;
    padding: 0.7rem 0.9rem;
    background: rgb(20 17 14 / 0.84);
    border-top: 1px solid var(--brass);
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--cream-200);
  }
  .media__illus strong {
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-light);
  }
  .media--fade-none .media__illus {
    left: 0;
  }
  .media .ph {
    position: absolute;
    inset: 0;
  }
  .media--fade-left .ph {
    place-items: end end;
    padding-left: 30%;
  }
  .media .ph :global(.todo) {
    font-size: 0.7rem;
  }
</style>
