---
import { Image } from 'astro:assets';
import { photos, isSpacer, type Photo, type PhotoSlotName } from '../data/photos';

interface Props {
  slot: PhotoSlotName;
  todo?: string;
  eager?: boolean;
  skip?: number;
  max?: number;
  class?: string;
}

const { slot, eager = false, skip = 0, max = 2, class: className } = Astro.props;
const list = (photos[slot] ?? []).filter((item): item is Photo => !isSpacer(item)).slice(skip, skip + max);
const gallery = list.length > 1;
const widths = [360, 600, 900, 1280, 1600];
const sizes = gallery ? '(min-width: 40rem) 44vw, 100vw' : '(min-width: 72rem) 70rem, 100vw';
---

{list.length > 0 && (
  <div class:list={['photo-slot', {'photo-slot--gallery': gallery}, className]}>
    {list.map((photo, i) => (
      <figure>
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={widths.filter((w) => w < photo.src.width).concat(Math.min(photo.src.width, 1800))}
          sizes={sizes}
          format="webp"
          quality={79}
          loading={eager && i === 0 ? 'eager' : 'lazy'}
          fetchpriority={eager && i === 0 ? 'high' : undefined}
        />
        {photo.illustration && <figcaption>Fictional design concept</figcaption>}
      </figure>
    ))}
  </div>
)}

<style>
  .photo-slot { display: grid; gap: clamp(.75rem, 2vw, 1.5rem); }
  @media (min-width: 40rem) {
    .photo-slot--gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  figure { position: relative; margin: 0; }
  figure :global(img) { display: block; width: 100%; height: auto; }
  .photo-slot--gallery :global(img) { aspect-ratio: 4 / 3; object-fit: cover; }
  figcaption {
    position: absolute;
    inset: auto auto .65rem .65rem;
    padding: .28rem .58rem;
    max-width: calc(100% - 1.3rem);
    color: #faf6ee;
    background: #201d1a;
    font: 500 .78rem/1.4 var(--font-body, system-ui);
    letter-spacing: .02em;
  }
</style>
