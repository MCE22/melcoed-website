---
// Renders a page's photos from src/data/photos.ts, or a TODO box when the slot is empty.
// One photo: a single framed image. Two or more: a responsive gallery grid.
import { Image } from 'astro:assets';
import Todo from './Todo.astro';
import { photos, type PhotoSlotName } from '../data/photos';
import { confidential } from '../data/confidential';

interface Props {
  slot: PhotoSlotName;
  /** What photo(s) the slot needs; shown in the TODO box while empty. */
  todo: string;
  /** Load immediately (above-the-fold images only). */
  eager?: boolean;
  /** Skip the first N photos (e.g. 1 when the page hero already shows photo 0). */
  skip?: number;
  class?: string;
}
const { slot, todo, eager = false, skip = 0, class: className } = Astro.props;
const all = photos[slot] ?? [];
const list = all.slice(skip);
const gallery = list.length > 1;
const illustrated = list.some((p) => p.illustration);
const widths = [480, 800, 1200, 1600];
const sizes = gallery ? '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw' : '(min-width: 72rem) 70rem, 100vw';
---

{
  all.length > 0 && list.length === 0 ? null : list.length === 0 ? (
    <Todo block>
      {todo} Save to <code>src/assets/photos/</code> and add to the <code>{slot}</code> slot in
      <code>src/data/photos.ts</code>.
    </Todo>
  ) : (
    <div class:list={['photo-slot', { 'photo-slot--gallery': gallery, 'photo-slot--pairs': list.length % 3 !== 0 && list.length % 2 === 0 }, className]}>
      {list.map((p, i) => (
        <figure class:list={['photo-slot__frame', { 'photo-slot__frame--illus': p.illustration }]}>
          {p.illustration && <span class="illus-tag">Illustration</span>}
          <Image
            src={p.src}
            alt={p.alt}
            widths={widths.filter((w) => w <= p.src.width)}
            sizes={sizes}
            format="webp"
            quality={78}
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            fetchpriority={eager && i === 0 ? 'high' : undefined}
          />
        </figure>
      ))}
      {
        illustrated && (
          <div class="illus-notes">
            <p class="illus-notes__label">{confidential.illustrationLabel}</p>
            <p class="illus-notes__line">{confidential.galleryLine}</p>
          </div>
        )
      }
    </div>
  )
}

<style>
  .photo-slot {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .photo-slot--gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .photo-slot--gallery {
      grid-template-columns: repeat(3, 1fr);
    }
    /* 2 or 4 photos: two columns, so no orphan tile */
    .photo-slot--pairs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* Chrome-rimmed frame, matching the map and heritage frames */
  /* Dark frame with a brass hairline: suits moody shots on wood or steel */
  .photo-slot__frame {
    margin: 0;
    padding: 0;
    background: #14110e;
    border: 1px solid var(--rule);
  }
  .photo-slot__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .photo-slot__frame--illus {
    position: relative;
  }
  /* Visible label on every illustration */
  .illus-tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 1;
    padding: 0.3rem 0.55rem;
    background: rgb(20 17 14 / 0.82);
    border: 1px solid var(--brass);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass-light);
  }
  .illus-notes {
    grid-column: 1 / -1;
    padding-top: 0.25rem;
  }
  .illus-notes p {
    margin: 0;
  }
  .illus-notes__label {
    font-size: 0.85rem;
    color: var(--ink-600);
  }
  .illus-notes__line {
    margin-top: 0.75rem !important;
    padding-top: 0.75rem;
    border-top: 1px solid var(--brass);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--oxblood);
  }
  .photo-slot--gallery .photo-slot__frame :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
