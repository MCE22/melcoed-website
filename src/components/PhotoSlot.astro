---
// Renders a page's photos from src/data/photos.ts, or a TODO box when the slot is empty.
// One photo: a single framed image. Two or more: a responsive gallery grid.
import { Image } from 'astro:assets';
import Todo from './Todo.astro';
import { photos, type PhotoSlotName } from '../data/photos';

interface Props {
  slot: PhotoSlotName;
  /** What photo(s) the slot needs; shown in the TODO box while empty. */
  todo: string;
  /** Load immediately (above-the-fold images only). */
  eager?: boolean;
  /** Skip the first N photos (e.g. 1 when the page hero already shows photo 0). */
  skip?: number;
  class?: string;
}
const { slot, todo, eager = false, skip = 0, class: className } = Astro.props;
const all = photos[slot] ?? [];
const list = all.slice(skip);
const gallery = list.length > 1;
const widths = [480, 800, 1200, 1600];
const sizes = gallery ? '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw' : '(min-width: 72rem) 70rem, 100vw';
---

{
  all.length > 0 && list.length === 0 ? null : list.length === 0 ? (
    <Todo block>
      {todo} Save to <code>src/assets/photos/</code> and add to the <code>{slot}</code> slot in
      <code>src/data/photos.ts</code>.
    </Todo>
  ) : (
    <div class:list={['photo-slot', { 'photo-slot--gallery': gallery }, className]}>
      {list.map((p, i) => (
        <figure class="photo-slot__frame">
          <Image
            src={p.src}
            alt={p.alt}
            widths={widths.filter((w) => w <= p.src.width)}
            sizes={sizes}
            format="webp"
            quality={78}
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            fetchpriority={eager && i === 0 ? 'high' : undefined}
          />
        </figure>
      ))}
    </div>
  )
}

<style>
  .photo-slot {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .photo-slot--gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .photo-slot--gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  /* Chrome-rimmed frame, matching the map and heritage frames */
  /* Dark frame with a brass hairline: suits moody shots on wood or steel */
  .photo-slot__frame {
    margin: 0;
    padding: 0;
    background: #14110e;
    border: 1px solid var(--rule);
  }
  .photo-slot__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .photo-slot--gallery .photo-slot__frame :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
