---
// Interior page header: visible breadcrumbs, ribbon, H1, optional script accent and lead.
import type { Crumb } from '../lib/schema';

interface Props {
  title: string;
  /** Script-font line under the H1, e.g. "since 1948". */
  accent?: string;
  ribbon?: string;
  lead?: string;
  breadcrumbs?: Crumb[];
}
const { title, accent, ribbon, lead, breadcrumbs = [] } = Astro.props;
---

<section class="page-hero">
  <div class="wrap">
    {
      breadcrumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {breadcrumbs.map((c, i) =>
              i === breadcrumbs.length - 1 ? (
                <li aria-current="page">{c.name}</li>
              ) : (
                <li><a href={c.path}>{c.name}</a></li>
              ),
            )}
          </ol>
        </nav>
      )
    }
    <div class="sign sign--rivets page-hero__sign">
      {ribbon && <span class="ribbon">{ribbon}</span>}
      <h1>
        {title}
        {accent && <span class="script page-hero__accent">{accent}</span>}
      </h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-block: 1rem 0.5rem;
  }
  @media (min-width: 48rem) {
    .page-hero {
      padding-block: 1.5rem 1rem;
    }
  }
  .page-hero h1 {
    max-width: 22ch;
    margin-bottom: 1rem;
  }
  .page-hero__accent {
    display: block;
    margin-top: 0.3em;
    color: var(--robin);
    font-size: 0.62em;
    line-height: 1.1;
    transform: rotate(-2deg);
    transform-origin: left center;
  }
  .page-hero .lead {
    margin-bottom: 0;
    color: var(--cream-200);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-400);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--chrome);
  }
  .crumbs a {
    color: var(--ink-600);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--cherry);
    text-decoration: underline;
  }
</style>
