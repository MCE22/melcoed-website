---
import Logo from './Logo.astro';
import { site, divisions, productLinks, industryLinks, quoteHref, mapsUrl } from '../data/site';
import { liveLinks } from '../lib/routes';

interface Props {
  /** Hide the quote call-to-action band (e.g. on the quote page itself). */
  hideCta?: boolean;
}
const { hideCta = false } = Astro.props;
const year = new Date().getFullYear();
const products = liveLinks(productLinks);
const industries = liveLinks([{ label: 'All Industries', href: '/industries/' }, ...industryLinks]);
const company = liveLinks([
  { label: 'Capabilities', href: '/capabilities/' },
  { label: 'About Us', href: '/about/' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Request a Quote', href: quoteHref },
  { label: 'Contact', href: '/contact/' },
]);
// Division names always show; they link once their landing page exists.
const divisionItems = divisions.map((d) => ({ name: d.name, href: liveLinks(d.links)[0]?.href }));
---

<footer class:list={['site-footer', { 'site-footer--no-cta': hideCta }]}>
  {
    !hideCta && (
      <div class="footer-cta">
        <div class="wrap">
          <div class="sign sign--cherry sign--rivets footer-cta__panel">
            <p class="footer-cta__text">
              <span class="script">Got a print, a sketch or an old badge?</span>
              <span class="footer-cta__sub">Send it over. We'll tell you what it takes to strike it.</span>
            </p>
            <div class="btn-row">
              <a class="btn btn--cream" href={quoteHref}>Request a Quote</a>
              <a class="btn btn--ghost" href={`tel:${site.phone.e164}`}>Call {site.phone.display}</a>
            </div>
          </div>
        </div>
      </div>
    )
  }

  <div class="footer-main">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <Logo tone="cream" size="lg" />
        <p class="footer-tag">{site.tagline}</p>
        <address class="footer-nap">
          <strong>{site.name}</strong><br />
          {site.address.street}<br />
          {site.address.city}, {site.address.region} {site.address.postalCode}<br />
          <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
          {site.email && (
            <>
              <br />
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </>
          )}
        </address>
        <a class="footer-map" href={mapsUrl} rel="noopener" target="_blank">Get directions &rarr;</a>
      </div>

      <div class="footer-col">
        <h2 class="footer-h">Divisions</h2>
        <ul>
          {divisionItems.map((d) => <li>{d.href ? <a href={d.href}>{d.name}</a> : d.name}</li>)}
        </ul>
        {
          products.length > 0 && (
            <nav aria-label="Products">
              <h2 class="footer-h footer-h--spaced">Products</h2>
              <ul>{products.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            </nav>
          )
        }
      </div>

      {
        industries.length > 0 && (
          <nav class="footer-col" aria-label="Industries">
            <h2 class="footer-h">Industries</h2>
            <ul>{industries.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </nav>
        )
      }

      <nav class="footer-col" aria-label="Company">
        <h2 class="footer-h">Company</h2>
        <ul>{company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    </div>
  </div>

  <div class="footer-base">
    <div class="wrap footer-base__inner">
      <span>&copy; {year} {site.name} All rights reserved.</span>
      <span>Made in Pawtucket, R.I. &middot; Est. {site.foundingYear}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--cream-200);
    background: var(--navy);
  }
  .site-footer a {
    color: var(--cream-100);
    text-decoration: none;
  }
  .site-footer a:not(.btn):hover {
    color: var(--robin);
    text-decoration: underline;
  }

  /* CTA sign hangs half over the page, half over the footer */
  .footer-cta {
    background: linear-gradient(var(--offwhite) 50%, var(--navy) 50%);
    padding-top: 1rem;
  }
  .footer-cta__panel {
    display: grid;
    gap: 1.25rem;
  }
  .footer-cta__text {
    margin: 0;
  }
  .footer-cta__text .script {
    display: block;
    font-size: clamp(1.9rem, 6vw, 2.6rem);
    line-height: 1.1;
    color: var(--paper);
  }
  .footer-cta__sub {
    display: block;
    margin-top: 0.4rem;
    color: var(--cream);
  }
  /* scoped under .site-footer so the footer's link color doesn't override it */
  .site-footer .btn--cream {
    background: linear-gradient(180deg, var(--paper), var(--cream));
    color: var(--cherry-600);
    box-shadow:
      inset 0 1px 0 #fff,
      inset 0 -2px 0 rgb(0 0 0 / 0.1),
      0 3px 8px -3px rgb(0 0 0 / 0.35);
  }
  .site-footer .btn--cream:hover {
    background: var(--paper);
    color: var(--cherry-800);
  }
  @media (min-width: 48rem) {
    .footer-cta__panel {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 2rem;
    }
  }

  .footer-main {
    padding-block: 3rem;
  }
  .site-footer--no-cta .footer-main {
    border-top: 1px solid var(--chrome-dark);
  }
  .footer-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 40rem) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
    .footer-brand {
      grid-column: auto;
    }
  }
  .footer-tag {
    margin: 0.75rem 0 1rem;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--robin);
  }
  .footer-nap {
    font-style: normal;
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }
  .footer-map {
    font-size: 0.9rem;
  }
  .footer-h {
    display: inline-block;
    margin: 0 0 0.85rem;
    padding-bottom: 0.55rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--robin);
    /* chrome pinstripe underline */
    background:
      linear-gradient(var(--chrome-dark), var(--chrome-dark)) left bottom / 100% 1px no-repeat,
      linear-gradient(var(--chrome-dark), var(--chrome-dark)) left calc(100% - 3px) / 100% 1px no-repeat;
  }
  .footer-h--spaced {
    margin-top: 1.5rem;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-col li {
    padding: 0.3rem 0;
  }

  .footer-base {
    border-top: 1px solid rgb(180 186 193 / 0.25);
    font-size: 0.8rem;
    color: var(--chrome);
  }
  .footer-base__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 1.25rem;
  }
</style>
