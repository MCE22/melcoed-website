---
import Logo from './Logo.astro';
import { site, nav, quoteHref, mapsUrl } from '../data/site';
import { catalogs } from '../data/catalogs';
import { atAGlance } from '../data/downloads';
interface Props { hideCta?: boolean; }
const { hideCta = false } = Astro.props;
---
<footer>
  {!hideCta && (
    <section class="callout">
      <div class="wrap callout-inner">
        <div>
          <h2>Have a part in mind?</h2>
          <p>Send a print, a sketch or a photo. Tell us the first quantity you need and what you expect to reorder.</p>
        </div>
        <a href={quoteHref} class="btn btn--primary">Request a quote <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  )}
  <div class="base">
    <div class="wrap">
      <div class="columns">
        <div>
          <Logo width={192} eager={false} />
          <address><a href={mapsUrl}>{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}</a></address>
          <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a><br />
          {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
        </div>
        <nav aria-label="Explore"><h2>Explore</h2>{nav.map(item => <a href={item.href}>{item.label}</a>)}</nav>
        <nav aria-label="Buyer support">
          <h2>Buyer support</h2>
          <a href="/request-a-quote/">Request a quote</a><a href="/faq/">Ordering FAQ</a><a href="/contact/">Contact &amp; hours</a><a href="/search/">Search the site</a>
        </nav>
        <nav aria-label="Catalogs"><h2>From the shop</h2>
          {catalogs.map(c => <a href={c.href}>{c.label}</a>)}
          {atAGlance && <a href={atAGlance.href}>At a Glance (PDF)</a>}
        </nav>
      </div>
      <div class="legal"><span>© {new Date().getFullYear()} {site.name}</span><a href="/privacy/">Privacy policy</a></div>
    </div>
  </div>
</footer>
<style>
  .callout { background:var(--bone); border-top:1px solid var(--rule); }
  .callout-inner { display:flex; align-items:center; flex-wrap:wrap; justify-content:space-between; gap:1.5rem 3rem; padding-block:clamp(3rem,6vw,6rem); }
  .callout h2 { font-family:var(--font-serif); font-weight:500; }
  .callout p { color:var(--ink-600); margin:0; max-width:52ch; }
  .base { background:var(--navy); color:var(--cream); font-size:.94rem; }
  .base a { color:inherit; text-decoration:none; }
  .base a:hover { text-decoration:underline; }
  .base :global(.logo) { margin-bottom: .3rem; }
  .base :focus-visible { outline-color:var(--brass-light); }
  .columns { display:grid; grid-template-columns:1.35fr .8fr .9fr 1.1fr; gap:2rem; padding-block:clamp(3rem,6vw,5.5rem); }
  address { margin:1.4rem 0 .8rem; font-style:normal; }
  nav a { display:block; padding:.28rem 0; }
  nav h2 { color:var(--brass-light); font:650 .75rem/1.5 var(--font-body); letter-spacing:.1em; text-transform:uppercase; margin:0 0 .9rem; }
  .legal { display:flex; align-items:center; justify-content:space-between; border-top:1px solid #52606b; padding-block:1.1rem; font-size:.8rem; }
  @media(max-width:52rem) { .columns { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:35rem) { .columns { grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.8rem 1rem; } .columns > :first-child,.columns > :last-child { grid-column:1/-1; } }
</style>
