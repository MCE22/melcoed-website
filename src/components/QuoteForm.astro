---
// Quote request form, delivered by Web3Forms (https://web3forms.com) to the inbox
// the access key was registered with (quotes@melcoed.com).
//
// - With JS: submits via fetch and shows an inline success message.
// - Without JS: posts directly to Web3Forms, which redirects to /request-a-quote/thank-you/.
// - Spam: Web3Forms `botcheck` honeypot (hidden checkbox; bots tick it, people never see it).
// - File uploads are a Web3Forms Pro feature; the field only renders when
//   PUBLIC_WEB3FORMS_FILE_UPLOADS=true. Otherwise visitors are told to email drawings.
import Todo from './Todo.astro';
import { site } from '../data/site';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const uploadsEnabled = import.meta.env.PUBLIC_WEB3FORMS_FILE_UPLOADS === 'true';
// TODO: confirm the per-submission attachment limit on the Web3Forms plan you buy; 10 MB assumed.
const maxUploadMb = 10;
const redirect = new URL('/request-a-quote/thank-you/', Astro.site ?? site.url).toString();

// `key` lets other pages preselect a type: /request-a-quote/?type=fraternal
const productTypes = [
  { key: 'badges', label: 'Badges (police, fire, military, government, corporate)' },
  { key: 'medallions', label: 'Medallions or challenge coins' },
  { key: 'awards', label: 'Awards or recognition pins' },
  { key: 'fraternal', label: 'Fraternal or lodge emblems' },
  { key: 'commemorative', label: 'Commemorative / 250th anniversary' },
  { key: 'findings', label: 'Findings or raw stampings' },
  { key: 'industrial', label: 'Industrial components' },
  { key: 'milling', label: 'Milling or machined parts' },
  { key: 'other', label: 'Not sure / something else' },
];
---

{
  !accessKey && (
    <Todo block>
      Set <code>PUBLIC_WEB3FORMS_ACCESS_KEY</code> in Cloudflare Pages (Settings &rarr; Environment variables) and
      redeploy. Until then this form cannot send.
    </Todo>
  )
}

<form
  id="quote-form"
  class="qf"
  action="https://api.web3forms.com/submit"
  method="POST"
  enctype="multipart/form-data"
  data-max-mb={maxUploadMb}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="New quote request from melcoed.com" />
  <input type="hidden" name="from_name" value="melcoed.com quote form" />
  <input type="hidden" name="redirect" value={redirect} />
  <!-- Honeypot: hidden from people, irresistible to bots. Web3Forms rejects submissions where it's checked. -->
  <input type="checkbox" name="botcheck" class="qf__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <fieldset class="qf__group">
    <legend>Your details</legend>
    <div class="qf__row">
      <div class="qf__field">
        <label for="qf-name">Name <span class="qf__req" aria-hidden="true">*</span></label>
        <input id="qf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="qf__field">
        <label for="qf-company">Company / organization</label>
        <input id="qf-company" name="company" type="text" autocomplete="organization" />
      </div>
    </div>
    <div class="qf__row">
      <div class="qf__field">
        <label for="qf-email">Email <span class="qf__req" aria-hidden="true">*</span></label>
        <input id="qf-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="qf__field">
        <label for="qf-phone">Phone</label>
        <input id="qf-phone" name="phone" type="tel" autocomplete="tel" />
      </div>
    </div>
  </fieldset>

  <fieldset class="qf__group">
    <legend>Your parts</legend>
    <div class="qf__field">
      <label for="qf-type">What do you need?</label>
      <select id="qf-type" name="product_type">
        <option value="">Select one (optional)</option>
        {productTypes.map((t) => <option data-key={t.key}>{t.label}</option>)}
      </select>
    </div>
    <div class="qf__row">
      <div class="qf__field">
        <label for="qf-material">Material</label>
        <input id="qf-material" name="material" type="text" placeholder="e.g. brass, steel, or not sure" />
      </div>
      <div class="qf__field">
        <label for="qf-qty">Quantity <span class="qf__req" aria-hidden="true">*</span></label>
        <input id="qf-qty" name="quantity" type="text" required placeholder="e.g. 500, or 1,000 / 5,000" aria-describedby="qf-qty-hint" />
        <small id="qf-qty-hint" class="qf__hint">Estimates or several price breaks are fine.</small>
      </div>
    </div>
    <div class="qf__row">
      <div class="qf__field">
        <label for="qf-finish">Finish</label>
        <input id="qf-finish" name="finish" type="text" placeholder="e.g. plated, enameled, unfinished, not sure" />
      </div>
      <div class="qf__field">
        <label for="qf-deadline">Needed by</label>
        <input id="qf-deadline" name="deadline" type="date" />
      </div>
    </div>

    {
      uploadsEnabled ? (
        <div class="qf__field">
          <label for="qf-files">Drawings, CAD files or photos</label>
          <input
            id="qf-files"
            name="attachment"
            type="file"
            multiple
            accept=".pdf,.dxf,.dwg,.step,.stp,.igs,.iges,.ai,.eps,.svg,.png,.jpg,.jpeg,.heic,.zip"
            aria-describedby="qf-files-hint"
          />
          <small id="qf-files-hint" class="qf__hint">
            PDF, DXF, DWG, STEP, IGES, AI/EPS, images or ZIP. Up to {maxUploadMb} MB total.
          </small>
        </div>
      ) : (
        <p class="qf__note">
          <strong>Have a drawing, CAD file or photo?</strong> After you submit, email it to{' '}
          {site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : 'us'} with your name or company in the
          subject line and we'll attach it to your request.
        </p>
      )
    }

    <div class="qf__field">
      <label for="qf-notes">Notes</label>
      <textarea
        id="qf-notes"
        name="message"
        rows="5"
        placeholder="Size, thickness, tolerances, artwork, existing tooling, or anything else we should know."
      ></textarea>
    </div>
  </fieldset>

  <div class="qf__actions">
    <button class="btn btn--primary qf__submit" type="submit">Send Quote Request</button>
    <p class="qf__fine"><span aria-hidden="true">*</span> Required. We use your details only to respond to this request.</p>
  </div>

  <p class="qf__status" role="alert" aria-live="assertive" hidden></p>
</form>

<div id="quote-success" class="qf-success" tabindex="-1" hidden>
  <span class="ribbon">Received</span>
  <h2>Thanks, we've got it.</h2>
  <p>
    Your request is in our quote inbox. We'll review it and get back to you, usually with questions first if anything
    on the print needs clarifying.
  </p>
  <p><Todo>state your typical quote turnaround, e.g. "within 2 business days"</Todo></p>
  <p>Need to add something or in a hurry? Call <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>.</p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('#quote-form');
  const success = document.querySelector<HTMLElement>('#quote-success');

  if (form && success) {
    const status = form.querySelector<HTMLElement>('.qf__status')!;
    const submit = form.querySelector<HTMLButtonElement>('.qf__submit')!;
    const deadline = form.querySelector<HTMLInputElement>('#qf-deadline');
    const files = form.querySelector<HTMLInputElement>('#qf-files');
    const maxBytes = Number(form.dataset.maxMb) * 1024 * 1024;
    const phone = '(401) 724-2160';

    // Preselect product type from ?type=<key>
    const type = new URLSearchParams(location.search).get('type');
    const option = type && form.querySelector<HTMLOptionElement>(`#qf-type option[data-key="${CSS.escape(type)}"]`);
    if (option) option.selected = true;

    // Deadlines can't be in the past
    if (deadline) deadline.min = new Date().toISOString().slice(0, 10);

    const showError = (msg: string) => {
      status.textContent = msg;
      status.hidden = false;
    };

    files?.addEventListener('change', () => {
      const total = [...(files.files ?? [])].reduce((n, f) => n + f.size, 0);
      files.setCustomValidity(
        total > maxBytes ? `Files total ${(total / 1048576).toFixed(1)} MB; the limit is ${form.dataset.maxMb} MB.` : '',
      );
      files.reportValidity();
    });

    // The submit event only fires once native validation (required, type=email) has passed.
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = true;

      const data = new FormData(form);
      if (data.get('botcheck')) return; // bot: drop silently
      if (!data.get('access_key')) {
        showError(`The quote form isn't connected yet. Please call us at ${phone}.`);
        return;
      }
      data.delete('redirect'); // JSON response for fetch; redirect is only for the no-JS path

      const label = submit.textContent;
      submit.disabled = true;
      submit.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message || `HTTP ${res.status}`);

        form.reset();
        form.hidden = true;
        success.hidden = false;
        success.focus();
        success.scrollIntoView({ block: 'start' });
      } catch {
        showError(`Sorry, your request didn't go through. Please try again, or call us at ${phone}.`);
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  }
</script>

<style>
  .qf {
    display: grid;
    gap: 1.75rem;
  }
  .qf__hp {
    display: none !important;
  }
  .qf__group {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  legend {
    width: 100%;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--chrome);
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--navy);
  }
  .qf__row {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .qf__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .qf__field {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-width: 0;
  }
  label {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .qf__req {
    color: var(--red);
  }
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid var(--ink-400);
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 1rem; /* >=16px prevents iOS zoom on focus */
  }
  input[type='file'] {
    padding: 0.6rem;
    background: var(--cream-50);
    border-style: dashed;
  }
  textarea {
    resize: vertical;
    min-height: 8rem;
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--red);
    outline: 3px solid rgb(184 35 43 / 0.18);
    outline-offset: 0;
  }
  input:user-invalid,
  textarea:user-invalid {
    border-color: var(--red);
    background: #fff6f5;
  }
  ::placeholder {
    color: var(--ink-400);
  }
  .qf__hint {
    color: var(--ink-600);
    font-size: 0.85rem;
  }
  .qf__note {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--chrome-light);
    border-radius: var(--radius);
    background: var(--cream-100);
    font-size: 0.95rem;
  }
  .qf__actions {
    display: grid;
    gap: 0.75rem;
  }
  .qf__submit {
    width: 100%;
  }
  .qf__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  @media (min-width: 40rem) {
    .qf__actions {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 1.25rem;
    }
    .qf__submit {
      width: auto;
    }
  }
  .qf__fine {
    margin: 0;
    color: var(--ink-600);
    font-size: 0.85rem;
  }
  .qf__status {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 2px solid var(--red);
    background: #fff6f5;
    color: var(--red-900);
    font-weight: 600;
  }
  .qf-success {
    padding: 2rem 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--chrome);
    background: var(--paper);
    box-shadow:
      inset 0 0 0 6px var(--paper),
      inset 0 0 0 7px var(--chrome-light),
      var(--shadow);
  }
  .qf-success:focus {
    outline: none;
  }
  .qf-success p:last-child {
    margin-bottom: 0;
  }
</style>
