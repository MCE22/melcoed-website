---
// Quote request form, delivered by Web3Forms (https://web3forms.com) to the inbox
// the access key was registered with (sales@melcoed.com).
//
// - With a key: confirmed API success opens the thank-you page.
// - Without a key: prepare a reviewable email draft locally, or use the direct email link.
// - Without JS: posts directly to Web3Forms, which redirects to /request-a-quote/thank-you/.
// - Spam: Web3Forms `botcheck` honeypot (hidden checkbox; bots tick it, people never see it).
// - File uploads are a Web3Forms Pro feature; the field only renders when
//   PUBLIC_WEB3FORMS_FILE_UPLOADS=true. Otherwise visitors are told to email drawings.
import { site } from '../data/site';

const accessKey = (import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '').trim();
const uploadsEnabled = Boolean(accessKey) && import.meta.env.PUBLIC_WEB3FORMS_FILE_UPLOADS === 'true';
const maxUploadMb = 5;
// The native POST also returns a staging visitor to their preview.
const redirect = new URL('/request-a-quote/thank-you/', process.env.CF_PAGES_URL || Astro.site || site.url).href;
const email = site.email!;
// `key` lets other pages preselect a type: /request-a-quote/?type=fraternal
const productTypes = [
  { key: 'stamping', label: 'Metal stamping (parts to print)' },
  { key: 'custom', label: 'Custom product development (your design, exclusive die)' },
  { key: 'badges', label: 'Badges (police, fire, military, government, corporate)' },
  { key: 'medallions', label: 'Medals, medallions or challenge coins' },
  { key: 'awards', label: 'Awards or recognition pins' },
  { key: 'fraternal', label: 'Fraternal or lodge emblems' },
  { key: 'findings', label: 'Findings or raw stampings' },
  { key: 'pattern', label: 'Pattern stock or banding' },
  { key: 'milling', label: 'Precision milling (dies, tooling, parts)' },
  { key: 'other', label: 'Not sure / something else' },
];
---

{!accessKey && (
  <div class="qf__intro">
    <p>Use the form to prepare an email with your project details, or write directly to <a href={`mailto:${email}`}>{email}</a>. You can attach drawings before you send.</p>
  </div>
)}

<form
  id="quote-form"
  class="qf"
  action={accessKey ? 'https://api.web3forms.com/submit' : `mailto:${email}`}
  method="post"
  enctype={accessKey ? 'multipart/form-data' : 'text/plain'}
  data-max-mb={maxUploadMb}
  data-email={email}
  data-delivery={accessKey ? 'direct' : 'draft'}
  hidden={!accessKey}
>
  {accessKey && <>
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Quote request — melcoed.com" />
    <input type="hidden" name="from_name" value="melcoed.com quote form" />
    <input type="hidden" name="redirect" value={redirect} />
    <input type="checkbox" name="botcheck" class="qf__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
  </>}

  <fieldset class="qf__group">
    <legend>Contact information</legend>
    <div class="qf__row">
      <div class="qf__field">
        <label for="qf-name">Name <span class="qf__req" aria-hidden="true">*</span></label>
        <input id="qf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="qf__field">
        <label for="qf-company">Company / organization</label>
        <input id="qf-company" name="company" type="text" autocomplete="organization" />
      </div>
    </div>
    <div class="qf__row">
      <div class="qf__field">
        <label for="qf-email">Email <span class="qf__req" aria-hidden="true">*</span></label>
        <input id="qf-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="qf__field">
        <label for="qf-phone">Phone</label>
        <input id="qf-phone" name="phone" type="tel" autocomplete="tel" />
      </div>
    </div>
  </fieldset>

  <fieldset class="qf__group">
    <legend>Project details</legend>
    <div class="qf__field">
      <label for="qf-type">What do you need?</label>
      <select id="qf-type" name="product_type">
        <option value="">Select project type</option>
        {productTypes.map((t) => <option data-key={t.key}>{t.label}</option>)}
      </select>
    </div>
    <div class="qf__row">
      <div class="qf__field">
        <label for="qf-material">Material</label>
        <input id="qf-material" name="material" type="text" placeholder="e.g. brass, steel, or not sure" />
      </div>
      <div class="qf__field">
        <label for="qf-qty">Quantity <span class="qf__req" aria-hidden="true">*</span></label>
        <input id="qf-qty" name="quantity" type="text" required placeholder="e.g. 500, or 1,000 / 5,000" aria-describedby="qf-qty-hint" />
        <small id="qf-qty-hint" class="qf__hint">Estimates or several price breaks are fine.</small>
      </div>
    </div>
    <div class="qf__row">
      <div class="qf__field">
        <label for="qf-finish">Finish</label>
        <input id="qf-finish" name="finish" type="text" placeholder="e.g. plated, enameled, unfinished, not sure" />
      </div>
      <div class="qf__field">
        <label for="qf-deadline">Needed by</label>
        <input id="qf-deadline" name="deadline" type="date" />
      </div>
    </div>

    <div class="qf__field">
      <label for="qf-repeat">Reorder plans <small>(optional)</small></label>
      <input id="qf-repeat" name="repeat_orders" placeholder="e.g. 2,000 initially, then 500 each quarter" />
    </div>

    {
      uploadsEnabled ? (
        <div class="qf__field">
          <label for="qf-files">Drawings, CAD files or photos</label>
          <input
            id="qf-files"
            name="attachment"
            type="file"
            multiple
            accept=".pdf,.dxf,.dwg,.step,.stp,.igs,.iges,.ai,.eps,.svg,.png,.jpg,.jpeg,.heic,.zip"
            aria-describedby="qf-files-hint"
          />
          <small id="qf-files-hint" class="qf__hint">
            PDF, DXF, DWG, STEP, IGES, AI/EPS, images or ZIP. Up to {maxUploadMb} MB total.
          </small>
        </div>
      ) : accessKey && (
        <p class="qf__note">
          <strong>Have a drawing, CAD file or photo?</strong> After you submit, email it to{' '}
          {site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : 'us'} with your name or company in the
          subject line and we'll attach it to your request.
        </p>
      )
    }

    <div class="qf__field">
      <label for="qf-notes">Notes</label>
      <textarea
        id="qf-notes"
        name="message"
        rows="5"
        placeholder="Size, thickness, tolerances, artwork, existing tooling, or anything else we should know."
      ></textarea>
    </div>
  </fieldset>

  <div class="qf__actions">
    <button class="btn btn--primary qf__submit" type="submit">{accessKey ? 'Send quote request' : 'Prepare quote email'}</button>
    <p class="qf__fine"><span aria-hidden="true">*</span> Required. See how we handle your information in our <a href="/privacy/">Privacy Policy</a>.</p>
  </div>

  <p class="qf__status" role="alert" hidden></p>
  <button type="button" class="qf__rescue text-link" hidden>Prepare an email with these details</button>
</form>

<section id="quote-draft" class="qf__draft" tabindex="-1" hidden>
  <h2>Your email is ready to send</h2>
  <p>Open the draft in your email app, attach any drawings, then send. For webmail, copy the details below into a message to <a href={`mailto:${email}`}>{email}</a>.</p>
  <a id="qf-mailto" class="btn btn--primary">Open email draft</a>
  <label for="qf-summary">Project details to copy</label>
  <textarea id="qf-summary" rows="8" readonly></textarea>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#quote-form');
  const draft = document.querySelector<HTMLElement>('#quote-draft');

  if (form && draft) {
    const status = form.querySelector<HTMLElement>('.qf__status')!;
    const rescue = form.querySelector<HTMLButtonElement>('.qf__rescue')!;
    const submit = form.querySelector<HTMLButtonElement>('.qf__submit')!;
    const deadline = form.querySelector<HTMLInputElement>('#qf-deadline')!;
    const files = form.querySelector<HTMLInputElement>('#qf-files');
    const email = form.dataset.email!;
    const maxBytes = Number(form.dataset.maxMb) * 1024 * 1024;

    const requestedType = new URLSearchParams(location.search).get('type');
    const options = form.querySelectorAll<HTMLOptionElement>('#qf-type option[data-key]');
    const option = Array.from(options).find((item) => item.dataset.key === requestedType);
    if (option) option.selected = true;

    const today = new Date();
    const pad = (value: number) => String(value).padStart(2, '0');
    deadline.min = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;
    form.hidden = false;

    files?.addEventListener('change', () => {
      const total = Array.from(files.files ?? []).reduce((sum, file) => sum + file.size, 0);
      files.setCustomValidity(total > maxBytes ? `Use up to ${form.dataset.maxMb} MB in total, or email the files separately.` : '');
      files.reportValidity();
    });

    function prepareEmail() {
      if (!form!.reportValidity()) return;
      const data = new FormData(form!);
      const labels = [
        ['name', 'Name'], ['company', 'Company'], ['email', 'Email'], ['phone', 'Phone'],
        ['product_type', 'Project type'], ['material', 'Material'], ['quantity', 'Quantity'],
        ['finish', 'Finish'], ['deadline', 'Needed by'], ['repeat_orders', 'Reorder plans'], ['message', 'Project notes'],
      ];
      const summary = labels
        .filter(([key]) => String(data.get(key) ?? '').trim())
        .map(([key, label]) => `${label}: ${String(data.get(key)).trim()}`)
        .join('\n');
      const subject = ['Quote request', data.get('company') || data.get('name')].filter(Boolean).join(' — ');
      const link = draft!.querySelector<HTMLAnchorElement>('#qf-mailto')!;
      link.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(summary)}`;
      draft!.querySelector<HTMLTextAreaElement>('#qf-summary')!.value = summary;
      draft!.hidden = false;
      draft!.focus();
    }
    form.addEventListener('input', () => { draft.hidden = true; });
    rescue.addEventListener('click', prepareEmail);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.disabled) return;
      status.hidden = true;
      rescue.hidden = true;
      if (form.dataset.delivery === 'draft') {
        prepareEmail();
        return;
      }

      const data = new FormData(form);
      if (data.get('botcheck')) return;
      data.delete('redirect');
      data.set('replyto', String(data.get('email') ?? '').trim());
      data.set('subject', ['Quote request', data.get('name'), data.get('company')].filter(Boolean).join(' — '));
      submit.disabled = true;
      submit.textContent = 'Sending…';
      try {
        const response = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error('Delivery unconfirmed');
        (window as unknown as { zaraz?: { track?: (event: string) => void } }).zaraz?.track?.('quote_submitted');
        window.location.assign('/request-a-quote/thank-you/');
      } catch {
        status.textContent = 'We could not confirm delivery. Your details are still here. You can email the same request to our team.';
        status.hidden = false;
        rescue.hidden = false;
        submit.disabled = false;
        submit.textContent = 'Send quote request';
      }
    });
  }
</script>

<style>
  .qf {
    display: grid;
    gap: 1.75rem;
  }
  .qf__hp {
    display: none !important;
  }
  .qf__group {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  legend {
    width: 100%;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--chrome);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--navy);
  }
  .qf__row {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .qf__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .qf__field {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-width: 0;
  }
  label {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .qf__req {
    color: var(--red);
  }
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid var(--ink-400);
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 1rem; /* >=16px prevents iOS zoom on focus */
  }
  input[type='file'] {
    padding: 0.6rem;
    background: var(--cream-50);
    border-style: dashed;
  }
  input::file-selector-button { border-radius: var(--radius); }
  textarea {
    resize: vertical;
    min-height: 8rem;
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--red);
    outline: 3px solid rgb(184 35 43 / 0.18);
    outline-offset: 0;
  }
  input:user-invalid,
  textarea:user-invalid {
    border-color: var(--red);
    background: #fff6f5;
  }
  ::placeholder {
    color: var(--ink-400);
  }
  .qf__hint {
    color: var(--ink-600);
    font-size: 0.85rem;
  }
  .qf__note {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--chrome-light);
    border-radius: var(--radius);
    background: var(--cream-100);
    font-size: 0.95rem;
  }
  .qf__actions {
    display: grid;
    gap: 0.75rem;
  }
  .qf__submit {
    width: 100%;
  }
  .qf__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  @media (min-width: 40rem) {
    .qf__actions {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 1.25rem;
    }
    .qf__submit {
      width: auto;
    }
  }
  .qf__fine {
    margin: 0;
    color: var(--ink-600);
    font-size: 0.85rem;
  }
  .qf__draft, .qf__status { border-radius: var(--radius-lg); }
  .qf__status {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 2px solid var(--red);
    background: #fff6f5;
    color: var(--red-900);
    font-weight: 600;
  }
  .qf[hidden], .qf__draft[hidden], .qf__rescue[hidden] { display: none; }
  .qf__intro { margin-bottom: 1.25rem; }
  .qf__rescue { justify-self: start; cursor: pointer; }
  .qf__draft { margin-top: 1.5rem; padding: 1.5rem; border: 1px solid var(--rule); background: var(--cream); scroll-margin: 1rem; }
  .qf__draft h2 { font-size: 1.5rem; }
  .qf__draft label { display: block; margin: 1.25rem 0 .35rem; }
  .qf__field small { font-weight: 400; }
</style>
