---
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import '../styles/motion.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import { sealPng } from '../data/brand';
import {
  organizationNode,
  websiteNode,
  webPageNode,
  breadcrumbNode,
  graph,
  type Crumb,
} from '../lib/schema';

interface Props {
  /** Page title without the brand suffix. Home passes `fullTitle` instead. */
  title: string;
  /** Use as-is (no " | Mel-Co-Ed, Inc." suffix). */
  fullTitle?: boolean;
  /** 140–160 characters; becomes meta description, OG description and WebPage description. */
  description: string;
  /** Extra schema.org nodes for this page (FAQPage, Product, ...). */
  schema?: Record<string, unknown>[];
  /** Breadcrumb trail excluding Home, e.g. [{ name: 'Badges', path: '/badges/' }]. */
  breadcrumbs?: Crumb[];
  /** schema.org WebPage subtype: 'AboutPage', 'ContactPage', 'FAQPage', 'CollectionPage'... */
  pageType?: string;
  ogImage?: string;
  noindex?: boolean;
  hideFooterCta?: boolean;
  /** Include this page in the site search index (Pagefind). */
  searchable?: boolean;
}

const {
  title,
  fullTitle = false,
  description,
  schema = [],
  breadcrumbs = [],
  pageType,
  ogImage = '/og-default.png',
  noindex = false,
  hideFooterCta = false,
  searchable = !noindex,
} = Astro.props;

const path = Astro.url.pathname;
const pageTitle = fullTitle ? title : `${title} | ${site.name}`;
const canonical = new URL(path, Astro.site ?? site.url).toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? site.url).toString();

// Favicon: from the official seal image when present, else the generated SVG.
const favicon32 = sealPng ? await getImage({ src: sealPng, width: 32, height: 32, format: 'png' }) : undefined;
const appleIcon = sealPng ? await getImage({ src: sealPng, width: 180, height: 180, format: 'png' }) : undefined;

const nodes = [
  organizationNode(),
  websiteNode(),
  webPageNode({ path, title: pageTitle, description, type: pageType }),
  ...(breadcrumbs.length ? [breadcrumbNode([{ name: 'Home', path: '/' }, ...breadcrumbs])] : []),
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      favicon32 ? (
        <>
          <link rel="icon" href={favicon32.src} type="image/png" sizes="32x32" />
          <link rel="apple-touch-icon" href={appleIcon?.src} />
        </>
      ) : (
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f4efe6" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="US-RI" />
    <meta name="geo.placename" content="Pawtucket" />

    <script is:inline type="application/ld+json" set:html={graph(nodes)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <Footer hideCta={hideFooterCta} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
