---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import FaqList from '../../components/FaqList.astro';
import { site, fullAddress, mapsUrl } from '../../data/site';
import { faqPageNode, type Faq } from '../../lib/schema';

const path = '/request-a-quote/';
const breadcrumbs = [{ name: 'Request a Quote', path }];

const faqs: Faq[] = [
  {
    q: 'What should I include in a metal stamping quote request?',
    a: 'The quantity (or several price breaks), material and thickness, finish, the date you need parts, and a drawing, CAD file, sketch or photo of the part. If you have existing tooling or a sample, tell us. The more we know up front, the faster and more accurate the quote.',
  },
  {
    q: 'What file formats can I send?',
    a: 'PDF drawings, DXF, DWG, STEP and IGES CAD files, Adobe Illustrator or EPS artwork, and ordinary photos all work. If you only have a physical sample, describe it in the request and we will arrange to see it.',
  },
  {
    q: 'Can I get a quote for a reproduction of an old badge, emblem or part?',
    a: 'Yes. Send clear photos of the front, back and edge with the overall dimensions, or tell us you have a sample. We will let you know what reproducing it involves.',
    todo: true,
  },
  {
    q: 'Will you sign an NDA before reviewing my drawings?',
    a: 'Yes. Send your NDA with the request or ask us for ours.',
    todo: true,
  },
];
---

<BaseLayout
  title="Request a Quote: Custom Metal Stamping"
  description="Request a quote for custom metal stamping from Mel-Co-Ed in Pawtucket, RI: badges, medallions, emblems, findings and industrial parts. Send your quantity, material and drawing."
  pageType="ContactPage"
  hideFooterCta
  breadcrumbs={breadcrumbs}
  schema={[faqPageNode(path, faqs)]}
>
  <PageHero
    title="Request a Quote"
    accent="tell us what to strike"
    ribbon="Custom stamping"
    lead="Badges, medallions, emblems, findings or parts built to print. Give us the basics and we'll come back with pricing, tooling and any questions about your design."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="wrap quote">
      <div class="quote__form card">
        <QuoteForm />
      </div>

      <aside class="quote__aside" aria-label="Other ways to reach us">
        <div class="aside-block">
          <h2 class="aside-h">What happens next</h2>
          <ol class="next">
            <li>We review your request and drawing for manufacturability.</li>
            <li>If anything is unclear, we call or email with questions.</li>
            <li>You get a quote covering tooling (if needed) and piece price at your quantities.</li>
          </ol>
        </div>

        <div class="aside-block aside-block--ink">
          <h2 class="aside-h">Rather talk it through?</h2>
          <p><a class="aside-phone" href={`tel:${site.phone.e164}`}>{site.phone.display}</a></p>
          {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
          <address>
            {site.name}<br />
            {fullAddress}
          </address>
          <p><a href={mapsUrl} rel="noopener" target="_blank">Get directions &rarr;</a></p>
        </div>

        <div class="aside-block">
          <h2 class="aside-h">For a faster quote</h2>
          <ul class="tips">
            <li>Give 2&ndash;3 quantity breaks so you can see how price scales.</li>
            <li>Say whether you already own tooling for this part.</li>
            <li>Mention critical dimensions or tolerances up front.</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="quote-faq-h">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <span class="ribbon">Questions</span>
        <h2 id="quote-faq-h">About quoting</h2>
      </div>
      <FaqList faqs={faqs} />
    </div>
  </section>
</BaseLayout>

<style>
  .quote {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .quote__form {
    padding: 1.25rem;
  }
  @media (min-width: 40rem) {
    .quote__form {
      padding: 2rem;
    }
  }
  @media (min-width: 64rem) {
    .quote {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 3rem;
    }
    .quote__aside {
      position: sticky;
      top: calc(var(--header-h) + 3rem);
    }
  }
  .quote__aside {
    display: grid;
    gap: 1.25rem;
  }
  .aside-block {
    padding: 1.25rem;
    border-top: 4px solid var(--red);
    background: var(--cream);
  }
  .aside-block--ink {
    background: var(--ink);
    color: var(--cream-200);
  }
  .aside-block--ink a {
    color: var(--cream);
  }
  .aside-block--ink .aside-h {
    color: var(--cream-50);
  }
  .aside-block address {
    font-style: normal;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }
  .aside-block p:last-child,
  .aside-block ol,
  .aside-block ul {
    margin-bottom: 0;
  }
  .aside-h {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .aside-phone {
    font-family: var(--font-block);
    font-size: 2rem;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  .next,
  .tips {
    padding-left: 1.2rem;
    font-size: 0.95rem;
  }
  .next li + li,
  .tips li + li {
    margin-top: 0.4rem;
  }
  .next li::marker {
    font-family: var(--font-block);
    color: var(--red);
  }
  @media (min-width: 56rem) {
    .faq-wrap {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
      align-items: start;
    }
  }
</style>
