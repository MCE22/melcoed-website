---
// Landing page for the no-JavaScript form path (Web3Forms redirects here).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Todo from '../../components/Todo.astro';
import { site } from '../../data/site';
---

<BaseLayout title="Quote Request Received" description="Your quote request was received by Mel-Co-Ed, Inc." noindex hideFooterCta>
  <section class="section">
    <div class="wrap" style="max-width:44rem">
      <span class="ribbon">Received</span>
      <h1>Thanks, we've got it.</h1>
      <p class="lead">
        Your request is in our quote inbox. We'll review it and get back to you, usually with questions first if
        anything on the print needs clarifying.
      </p>
      <p><Todo>state your typical quote turnaround, e.g. "within 2 business days"</Todo></p>
      {
        site.email && (
          <p>
            Have drawings to add? Email them to <a href={`mailto:${site.email}`}>{site.email}</a> with your name or company
            in the subject line.
          </p>
        )
      }
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Back to Home</a>
        <a class="btn btn--ghost" href={`tel:${site.phone.e164}`}>Call {site.phone.display}</a>
      </div>
    </div>
  </section>
</BaseLayout>
