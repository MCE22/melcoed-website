---
// Landing page for the no-JavaScript form path (Web3Forms redirects here).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---

<BaseLayout title="Quote Request Received" description="Your quote request was received by Mel-Co-Ed, Inc." noindex hideFooterCta>
  <section class="section">
    <div class="wrap" style="max-width:44rem">
      <span class="ribbon">Received</span>
      <h1>Thanks, we've got it.</h1>
      <p class="lead">
        Your request is in our quote inbox. You'll get an automatic first reply with our sell sheet and catalogs. Your
        quote, pricing and order details are reviewed by a person before we send them.
      </p>
      <p>We reply within one business day.</p>
      {
        site.email && (
          <p>
            Have drawings to add? Email them to <a href={`mailto:${site.email}`}>{site.email}</a> with your name or company
            in the subject line.
          </p>
        )
      }
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Back to home</a>
        <a class="text-link" href={`tel:${site.phone.e164}`}>or call {site.phone.display}</a>
      </div>
    </div>
  </section>
</BaseLayout>
