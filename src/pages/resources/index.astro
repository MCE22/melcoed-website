---
// Resources hub: every buyer-question page, grouped.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { resources, resourceGroups, resourceHref } from '../../data/resources';
import { site, quoteHref } from '../../data/site';

const path = '/resources/';
const breadcrumbs = [{ name: 'Resources', path }];
const groupId = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const itemList = {
  '@type': 'ItemList',
  name: 'Mel-Co-Ed buyer guides',
  itemListElement: resources.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r.h1,
    url: new URL(resourceHref(r), site.url).toString(),
  })),
};
---

<BaseLayout
  title="Buyer Guides: Metal Stamping, Die Striking, Findings & Emblems"
  description="Straight answers to the questions buyers ask about metal stamping, die striking, tooling, jewelry findings and emblems, from Mel-Co-Ed in Rhode Island since 1948."
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
  schema={[itemList]}
  hideFooterCta
>
  <PageHero
    title="Buyer guides"
    lead="Use these guides to compare stamping processes, understand tooling costs and prepare a part for quoting. Choose a topic below."
    breadcrumbs={breadcrumbs}
  >
    <nav class="subjects" aria-label="Guide topics">{resourceGroups.map(group => <a href={`#${groupId(group)}`}>{group}</a>)}</nav>
  </PageHero>

  <section class="section">
    <div class="wrap groups">
      {
        resourceGroups.map((g) => (
          <section id={groupId(g)} class="group" aria-label={g}>
            <h2 class="group__h">{g}</h2>
            <ul class="group__list">
              {resources
                .filter((r) => r.group === g)
                .map((r) => (
                  <li>
                    <a href={resourceHref(r)}>{r.h1}<span aria-hidden="true">↗</span></a>
                  </li>
                ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap not-answered">
      <h2>Discuss your part with the shop</h2>
      <a class="btn btn--primary" href={quoteHref}>Request a quote <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .subjects { display:flex; flex-wrap:wrap; gap:.4rem 1.25rem; margin-top:1.45rem; }
  .subjects a { font-size:.96rem; padding:.3rem 0; }
  .groups { display:grid; gap:clamp(2.4rem,5vw,4.6rem); }
  .group { border-top:2px solid var(--navy); padding-top:1.2rem; display:grid; align-items:start; gap:1rem; }
  .group__h { font-size:clamp(1.55rem,2.7vw,2.45rem); }
  .group__list { margin:0; list-style:none; padding:0; }
  .group__list li { border-bottom:1px solid var(--rule); }
  .group__list a { display:flex; justify-content:space-between; gap:1rem; align-items:baseline; padding:.9rem 0; color:var(--ink); text-decoration:none; }
  .group__list li:first-child a { padding-top:.3rem; }
  .group__list span { color:var(--oxblood); }
  .group__list a:hover { color:var(--oxblood); text-decoration:underline; }
  @media(min-width:52rem){ .group { grid-template-columns:minmax(0,1fr) minmax(0,1.7fr); gap:clamp(2rem,6vw,6rem); } }
  .not-answered {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .not-answered h2 {
    margin: 0;
  }
</style>
