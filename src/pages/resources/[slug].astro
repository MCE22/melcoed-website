---
// Buyer-question page. Content: src/data/resources.ts (one entry per page).
// Order: question + direct answer → facts table → how we make it → FAQ → links + quote.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import { resources, resourceHref, dieOwnership, type Resource } from '../../data/resources';
import { confidential } from '../../data/confidential';
import { quoteHref, site } from '../../data/site';
import { faqPageNode } from '../../lib/schema';
import { isLive } from '../../lib/routes';

export function getStaticPaths() {
  return resources.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const { r } = Astro.props as { r: Resource };
const path = resourceHref(r);
const breadcrumbs = [
  { name: 'Resources', path: '/resources/' },
  { name: r.h1, path },
];
const quote = `${quoteHref}?type=${r.quoteType}`;
const links = r.links.filter((l) => isLive(l.href));
const showDie = r.custom && r !== dieOwnership;
---

<BaseLayout title={r.metaTitle} fullTitle description={r.metaDescription} breadcrumbs={breadcrumbs} schema={[faqPageNode(path, r.faqs)]} hideFooterCta>
  <PageHero title={r.h1} ribbon={r.group} lead={r.answer} breadcrumbs={breadcrumbs} size="question">
    <div class="btn-row hero-cta">
      <a class="btn btn--primary" href={quote}>Request a Quote <span class="arr" aria-hidden="true">→</span></a>
      <a class="text-link" href={`tel:${site.phone.e164}`}>or call {site.phone.display}</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="facts-h">
    <div class="wrap split res">
      <div class="res__body">
        {r.body.map((p) => <p>{p}</p>)}
        <h2 class="res__h3">{r.list.heading}</h2>
        <ul class="res__list">{r.list.items.map((i) => <li>{i}</li>)}</ul>
        {
          r.image && (
            <MediaSlot slot={r.image.slot} index={r.image.index} aspect="4 / 3" sizes="(min-width: 56rem) 45vw, 100vw" todo="Illustration" class="res__img" />
          )
        }
      </div>
      <div>
        <h2 id="facts-h" class="res__h3">Facts at a glance</h2>
        <table class="facts">
          <tbody>
            {
              r.specs.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td>{row.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="how-h">
    <div class="wrap">
      <h2 id="how-h">How we make it</h2>
      <ol class="steps res-steps">
        {
          r.steps.map((s, i) => (
            <li class="step">
              <span class="step__n">0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <h2 id="faq-h">Questions buyers ask</h2>
      </div>
      <FaqList faqs={r.faqs} />
    </div>
  </section>

  <section class="section section--cream res-next" aria-label="Next steps">
    <div class="wrap res-next__grid">
      <div>
        {r.confidential && <p class="res-conf"><strong>{confidential.heading} {confidential.accent}</strong> {confidential.body}</p>}
        <ul class="res-links">
          {links.map((l) => <li><a href={l.href}>{l.label} &rarr;</a></li>)}
          {showDie && <li><a href={resourceHref(dieOwnership)}>Who owns the die? You do. &rarr;</a></li>}
          <li><a href="/resources/">All buyer guides &rarr;</a></li>
        </ul>
      </div>
      <a class="btn btn--primary" href={quote}>Request a Quote <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .res {
    align-items: start;
  }
  .res__body p {
    max-width: 38rem;
  }
  .res__h3 {
    margin: 2rem 0 0.75rem;
    font-size: 1.2rem;
  }
  .res > div:last-child .res__h3 {
    margin-top: 0;
  }
  .res__list {
    margin: 0;
    padding-left: 1.1rem;
  }
  .res__list li {
    padding: 0.2rem 0;
  }
  .res__list li::marker {
    color: var(--brass);
  }
  .res :global(.res__img) {
    margin-top: 2rem;
  }
  .facts {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--rule);
  }
  .facts th,
  .facts td {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }
  .facts th {
    width: 38%;
    padding-right: 1rem;
    font-size: 0.9rem;
    font-weight: 650;
  }
  .facts td {
    color: var(--ink-600);
  }
  @media (min-width: 64rem) {
    .res-steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .res-next__grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .res-next__grid {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }
  .res-conf {
    max-width: 44rem;
    margin: 0 0 1.25rem;
    padding: 1rem 1.25rem;
    background: var(--navy);
    color: var(--cream-200);
  }
  .res-conf strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--brass-light);
  }
  .res-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }
</style>
