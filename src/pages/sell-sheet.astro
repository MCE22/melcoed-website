---
// 2-page sell sheet (front/back, US Letter). Print layout only: no site header/footer.
// The PDF in public/downloads/ is exported from this page: `npm run sell-sheet`.
// Rules: never say "finished in-house" (plating, polishing and enamel are done by outside
// finishers), no castings, no customer names or logos, sales@ only.
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/inter/wght.css';
import { Image } from 'astro:assets';
import { site, fullAddress, quoteHref } from '../data/site';
import { platePng, brandAlt } from '../data/brand';
import { ordering } from '../data/facts';
import qrSvg from '../assets/brand/qr-request-a-quote.svg?raw';
import dieBlock from '../assets/photos/die-block-closeup.jpg';
import findingsBoards from '../assets/photos/findings-sample-boards.jpg';
import patternStock from '../assets/photos/pattern-stock.jpg';

const make = [
  'Jewelry findings & components',
  'Custom jewelry & product development',
  'Metal stampings',
  'Coins & challenge coins',
  'Medallions & awards',
  'Emblems & nameplates',
  'Badges & pins',
  'Fraternal & lodge jewels',
  'Religious medals',
  'Belt buckles',
  'Pattern stock & banding',
];

const shop = [
  '20+ presses: automatic 25–250 ton, secondary 5–25 ton',
  'Stamping .010″–.250″ stock, ±.002″ typical',
  'Die striking up to 3.5″ diameter, .250″ thick',
  'Coining, progressive, transfer and automatic stamping',
  'Dies built and maintained in our own tool room',
  'Prototypes and short-run tooling available',
];

const serve = [
  'Jewelry & fashion',
  'Awards & recognition',
  'Government & public safety',
  'Fraternal & lodge',
  'Corporate & promotional',
  'Religious goods',
  'Golf & sports',
];

const web = site.url.replace('https://', '');
const quoteUrl = `melcoed.com${quoteHref.replace(/\/$/, '')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Sell Sheet 2026 | {site.name}</title>
    <link rel="canonical" href={`${site.url}/sell-sheet/`} />
  </head>
  <body>
    <!-- ================= FRONT ================= -->
    <section class="sheet" aria-label="Sell sheet, front">
      <header class="hero">
        <Image src={platePng} alt={brandAlt} width={760} class="plate" loading="eager" />
        <div class="hero__text">
          <h1><span>Coined. Die struck.</span><span>Stamped.</span><span class="since">Since 1948.</span></h1>
          <p class="hero__who">{site.name} · Pawtucket, Rhode Island · Third generation, family-owned</p>
        </div>
      </header>
      <div class="made">★ Made in Rhode Island, USA ★</div>

      <div class="strip">
        <Image src={dieBlock} alt="A progressive die block on the bench in our tool room" width={640} />
        <Image src={findingsBoards} alt="Sample boards of stock jewelry findings and stampings" width={640} />
        <Image src={patternStock} alt="Embossed brass pattern stock and banding" width={640} />
      </div>

      <div class="body">
        <h2 class="eyebrow">Two ways to buy</h2>
        <div class="ways">
          <div class="way">
            <h3>Open Line</h3>
            <p>30,000+ stock findings, stampings and pattern stock. <strong>No tooling cost.</strong></p>
          </div>
          <div class="way">
            <h3>Confined &amp; Custom</h3>
            <p>Your design on your own exclusive die, run only for you. <strong>Have dies or metal? We’ll run yours.</strong></p>
          </div>
        </div>
      </div>

      <div class="die">
        <h2>Your die. Your design.</h2>
        <p>
          You own the die you pay for. We store it free, indefinitely. Take it anywhere.
          Your work stays confidential — NDA on request.
        </p>
      </div>

      <div class="body">
        <h2 class="eyebrow">What we make</h2>
        <ul class="make">{make.map((m) => <li>{m}</li>)}</ul>
      </div>

      <footer class="foot">
        <span>{fullAddress}</span>
        <strong>{site.phone.display}</strong>
        <span>{site.email}</span>
        <strong>{web}</strong>
      </footer>
    </section>

    <!-- ================= BACK ================= -->
    <section class="sheet" aria-label="Sell sheet, back">
      <header class="bar">
        <Image src={platePng} alt={brandAlt} width={420} class="plate plate--small" loading="eager" />
        <p class="bar__h">Built to your spec</p>
      </header>

      <div class="body grid">
        <div class="block">
          <h2 class="eyebrow">Shop</h2>
          <ul class="ticks">{shop.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div class="block">
          <h2 class="eyebrow">Materials</h2>
          <p>
            Brass (230/260), copper, nickel silver, sterling, fine silver, gold filled, solid 10K/14K/18K,
            stainless, aluminum, cold-rolled steel, zinc — <strong>or send us yours.</strong>
          </p>
          <h2 class="eyebrow">Finishes</h2>
          <p>
            High polish, satin, sandblast, antique, soft &amp; hard enamel, color fill.<br />
            <strong>Plating:</strong> gold, karat gold, silver, imitation rhodium.
          </p>
        </div>
        <div class="block">
          <h2 class="eyebrow">Services</h2>
          <p>Soldering &amp; assembly, engraving &amp; numbering, packaging, drop shipping.</p>
          <p><strong>Pin posts fused, never soldered.</strong></p>
        </div>
        <div class="block">
          <h2 class="eyebrow">Who we serve</h2>
          <ul class="serve">{serve.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>

      <div class="order">
        <h2>How to order</h2>
        <dl>
          <div><dt>Minimum</dt><dd>3 gross (432 pcs) per item. Smaller runs at a higher price. No minimum on sterling or gold.</dd></div>
          <div><dt>Lead time</dt><dd>{ordering.leadTime}, including new tooling.</dd></div>
          <div><dt>Pricing</dt><dd>Priced at order on current metal. Custom work quoted per job.</dd></div>
          <div><dt>Tooling</dt><dd>Billed separately or built into the piece price — your choice.</dd></div>
        </dl>
      </div>

      <footer class="contact">
        <div class="contact__qr" set:html={qrSvg} aria-hidden="true" />
        <div class="contact__cta">
          <a class="btn" href={`${site.url}${quoteHref}`}>Request a quote →</a>
          <p class="contact__url">Scan or visit<br /><strong>{quoteUrl}</strong></p>
        </div>
        <address class="contact__nap">
          <strong>{site.name}</strong><br />
          {fullAddress}<br />
          <strong class="big">{site.phone.display}</strong><br />
          {site.email} · {web}
        </address>
      </footer>
    </section>
  </body>
</html>

<style is:global>
  :root {
    --cream: #f4efe6;
    --paper: #faf7f1;
    --bone: #ebe4d7;
    --ink: #1b1815;
    --ink-600: #4a443e;
    --char: #181512;
    --oxblood: #7a1f1f;
    --brass: #a8843f;
    --brass-light: #cdb27a;
    --brass-text: #7d6028;
    --navy: #1c2533;
    --rule: #dcd2c1;
    --display: 'Archivo Variable', Archivo, 'Arial Black', Arial, sans-serif;
    --body: 'Inter Variable', Inter, system-ui, Arial, sans-serif;
  }
  @page {
    size: letter;
    margin: 0;
  }
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    background: #8e9399;
    color: var(--ink);
    font: 11.5pt/1.42 var(--body);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 8.5in;
    height: 11in;
    margin: 0.4in auto;
    overflow: hidden;
    background: var(--cream);
    box-shadow: 0 6px 30px rgb(0 0 0 / 0.35);
  }
  @media print {
    html,
    body {
      background: none;
    }
    .sheet {
      margin: 0;
      box-shadow: none;
      break-after: page;
    }
  }
  h1,
  h2,
  h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.02;
  }
  p {
    margin: 0 0 0.08in;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .body {
    padding: 0.28in 0.55in 0;
  }
  .eyebrow {
    margin-bottom: 0.12in;
    font-family: var(--body);
    font-size: 9pt;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--brass-text);
  }

  /* Front */
  .hero {
    display: grid;
    grid-template-columns: 2.4in 1fr;
    gap: 0.35in;
    align-items: center;
    padding: 0.5in 0.55in 0.4in;
    background: var(--char);
    color: var(--paper);
  }
  .plate {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.5);
  }
  .hero h1 {
    font-size: 29pt;
    letter-spacing: 0.005em;
  }
  .hero h1 span {
    display: block;
  }
  .hero h1 .since {
    color: var(--brass-light);
  }
  .hero__who {
    margin: 0.16in 0 0;
    font-size: 11pt;
    color: #ddd4c4;
  }
  .made {
    padding: 0.09in 0.55in;
    background: var(--brass);
    color: var(--char);
    font-family: var(--display);
    font-size: 12pt;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    height: 1.6in;
    overflow: hidden;
    background: var(--char);
  }
  .strip img {
    width: 100%;
    height: 1.6in;
    min-height: 0;
    object-fit: cover;
    display: block;
  }
  .ways {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.22in;
  }
  .way {
    padding: 0.16in 0.2in;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-top: 4px solid var(--brass);
  }
  .way h3 {
    margin-bottom: 0.08in;
    font-size: 17pt;
    color: var(--oxblood);
  }
  .way p {
    margin: 0;
    font-size: 11.5pt;
  }
  .die {
    margin: 0.28in 0.55in 0;
    padding: 0.2in 0.28in;
    background: var(--oxblood);
    color: var(--paper);
    border-left: 6px solid var(--brass);
  }
  .die h2 {
    margin-bottom: 0.08in;
    font-size: 20pt;
    color: var(--brass-light);
  }
  .die p {
    margin: 0;
    font-size: 12pt;
  }
  .make {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.07in 0.22in;
  }
  .make li {
    padding: 0.04in 0 0.04in 0.16in;
    border-left: 3px solid var(--brass);
    font-size: 11pt;
    font-weight: 600;
    line-height: 1.25;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 0.2in;
    margin-top: auto;
    padding: 0.2in 0.55in;
    background: var(--char);
    color: var(--paper);
    font-size: 10.5pt;
    border-top: 3px solid var(--brass);
  }
  .foot strong {
    color: var(--brass-light);
  }

  /* Back */
  .bar {
    display: flex;
    align-items: center;
    gap: 0.35in;
    padding: 0.4in 0.55in 0.32in;
    background: var(--char);
    border-bottom: 4px solid var(--brass);
  }
  .plate--small {
    width: 1.75in;
  }
  .bar__h {
    margin: 0;
    font-family: var(--display);
    font-size: 30pt;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--paper);
    line-height: 1;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.22in 0.4in;
    padding-top: 0.32in;
  }
  .block p {
    font-size: 11pt;
  }
  .block .eyebrow + p,
  .block .eyebrow + ul {
    margin-bottom: 0.16in;
  }
  .ticks li {
    position: relative;
    padding-left: 0.2in;
    margin-bottom: 0.06in;
    font-size: 11pt;
    line-height: 1.3;
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.075in;
    width: 0.08in;
    height: 0.08in;
    background: var(--oxblood);
  }
  .serve {
    display: grid;
    gap: 0.04in;
  }
  .serve li {
    font-size: 11pt;
    font-weight: 600;
  }
  .order {
    margin: 0.12in 0.55in 0.22in;
    padding: 0.22in 0.3in 0.2in;
    background: var(--navy);
    color: var(--paper);
    border-top: 4px solid var(--brass);
  }
  .order h2 {
    margin-bottom: 0.14in;
    font-size: 19pt;
    color: var(--brass-light);
  }
  .order dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.14in 0.35in;
    margin: 0;
  }
  .order dt {
    font-family: var(--body);
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-light);
  }
  .order dd {
    margin: 0.03in 0 0;
    font-size: 11pt;
  }
  .contact {
    display: grid;
    grid-template-columns: 1.15in 1fr auto;
    gap: 0.3in;
    align-items: center;
    margin-top: auto;
    padding: 0.3in 0.55in 0.38in;
    background: var(--char);
    color: var(--paper);
    border-top: 3px solid var(--brass);
  }
  .contact__qr {
    width: 1.15in;
    height: 1.15in;
    padding: 0.06in;
    background: var(--paper);
  }
  .contact__qr svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .btn {
    display: inline-block;
    padding: 0.12in 0.24in;
    background: var(--oxblood);
    color: var(--paper);
    border: 2px solid var(--brass);
    font-family: var(--display);
    font-size: 15pt;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .contact__url {
    margin: 0.1in 0 0;
    font-size: 10pt;
    color: #ddd4c4;
  }
  .contact__nap {
    white-space: nowrap;
    font-style: normal;
    font-size: 10.5pt;
    line-height: 1.5;
    text-align: right;
  }
  .contact__nap .big {
    font-family: var(--display);
    font-size: 17pt;
    color: var(--brass-light);
  }
</style>
