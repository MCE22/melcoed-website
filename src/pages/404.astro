---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, quoteHref } from '../data/site';
---

<BaseLayout title="Page Not Found" description="The page you were looking for isn't here." noindex>
  <section class="section">
    <div class="wrap">
      <span class="ribbon">Error 404</span>
      <h1>Page not found.</h1>
      <p class="lead">Use site search to find a part, a process or a buyer guide.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/search/">Search the site</a>
        <a class="btn btn--ghost" href={quoteHref}>Request a quote</a>
      </div>
      <p style="margin-top:2rem">Or call us at <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>.</p>
    </div>
  </section>
</BaseLayout>
