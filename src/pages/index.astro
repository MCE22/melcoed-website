---
import BaseLayout from '../layouts/BaseLayout.astro';
import Todo from '../components/Todo.astro';
import MediaSlot from '../components/MediaSlot.astro';
import Icon from '../components/Icon.astro';
import Seal from '../components/Seal.astro';
import FaqList from '../components/FaqList.astro';
import { site, divisions, quoteHref } from '../data/site';
import { madeIn } from '../data/brand';
import { isLive, liveLinks } from '../lib/routes';
import { industries } from '../data/industries';
import { generalFaqs } from '../data/faqs';
import type { PhotoSlotName } from '../data/photos';

const years = new Date().getFullYear() - site.foundingYear;


const steps = [
  { n: '01', title: 'Send your print', body: 'A drawing, CAD file, sketch or a physical sample. Tell us material, finish and quantity.' },
  { n: '02', title: 'Get a quote', body: 'We review manufacturability, tooling and piece price, and flag anything that could cost you later.' },
  { n: '03', title: 'Tooling', body: 'Dies are built and maintained in-house, so changes and repeat runs don’t wait on an outside shop.' },
  { n: '04', title: 'Strike, finish, ship', body: 'Parts are struck, trimmed and inspected in Pawtucket, finished to spec, then shipped to you.' },
];


// The four featured tiles under the hero (photos come from each product's slot).
const tiles: { label: string; href: string; slot: PhotoSlotName }[] = [
  { label: 'Awards & Recognition', href: '/awards/', slot: 'awards' },
  { label: 'Jewelry Findings', href: '/findings/', slot: 'findings' },
  { label: 'Badges & Insignia', href: '/badges/', slot: 'badges' },
  { label: 'Industrial Components', href: '/industrial-components/', slot: 'industrial-components' },
];

const approach = [
  {
    icon: 'die' as const,
    title: 'In-House Tooling',
    body: 'Dies are designed, built and maintained in our own shop, with CNC milling support. Changes and repeat runs stay on our schedule.',
  },
  {
    icon: 'caliper' as const,
    title: 'Consistent Quality',
    body: 'Parts are inspected before they ship. Tell us what documentation your quality system needs.',
  },
  {
    icon: 'pin' as const,
    title: madeIn.primary,
    sub: madeIn.secondary,
    body: `Struck in Pawtucket, Rhode Island, since ${site.foundingYear}.`,
  },
  {
    icon: 'hand' as const,
    title: 'A Partner You Can Count On',
    body: 'Third-generation and family-owned, in the same city for more than seven decades.',
  },
];

// Shown here as plain content; the FAQPage markup for these lives on /faq/.
const faqs = generalFaqs;
---

<BaseLayout
  title={`${site.name} | Precision Metal Stamping in Pawtucket, RI Since ${site.foundingYear}`}
  fullTitle
  description={`Third-generation, family-owned metal stamping in Pawtucket, RI since ${site.foundingYear}. Die-struck badges, medallions, awards, fraternal emblems, findings and industrial parts.`}
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Precision metal stamping &middot; Since {site.foundingYear}</p>
        <h1>American craftsmanship <em>builds brands.</em></h1>
        <p class="lead">
          Mel-Co-Ed is a third-generation, family-owned stamping shop in Pawtucket, Rhode Island. We build the tooling
          and strike the parts in-house: badges, medallions, emblems, findings and industrial components.
        </p>
        <div class="btn-row hero-cta">
          {
            isLive('/capabilities/') ? (
              <a class="btn btn--primary" href="/capabilities/">
                Explore our capabilities <span class="arr" aria-hidden="true">→</span>
              </a>
            ) : (
              <a class="btn btn--primary" href={quoteHref}>
                Request a quote <span class="arr" aria-hidden="true">→</span>
              </a>
            )
          }
        </div>
      </div>
      <MediaSlot
        slot="home-hero"
        aspect="5 / 4"
        fade="left"
        eager
        sizes="(min-width: 64rem) 55vw, 100vw"
        todo="Hero photo: dark, moody product shot on wood or steel (min. 2000px wide)"
        class="hero__media"
      />
      <p class="hero__tagline" aria-hidden="true">People. Precision. Possibilities. Since {site.foundingYear}.</p>
    </div>
  </section>

  <!-- ============ FEATURED TILES ============ -->
  <section class="tiles-wrap" aria-label="Featured products">
    <div class="wrap">
      <ul class="tiles">
        {
          tiles.map((t) => {
            const inner = (
              <>
                <MediaSlot slot={t.slot} aspect="4 / 5" sizes="(min-width: 64rem) 25vw, 50vw" todo="Photo" />
                <span class="tile__label">
                  {t.label} <span class="tile__arrow" aria-hidden="true">→</span>
                </span>
              </>
            );
            return <li>{isLive(t.href) ? <a class="tile" href={t.href}>{inner}</a> : <div class="tile">{inner}</div>}</li>;
          })
        }
      </ul>
    </div>
  </section>

  <!-- ============ TRUSTED ACROSS INDUSTRIES ============ -->
  <section class="trusted" aria-labelledby="trusted-h">
    <div class="wrap">
      <h2 id="trusted-h" class="eyebrow trusted__h">Trusted across industries</h2>
      <ul class="trusted__list">
        {
          industries.map((x) => (
            <li>
              {isLive(x.href) ? (
                <a href={x.href}>
                  <Icon name={x.icon} />
                  <span>{x.name}</span>
                </a>
              ) : (
                <span class="trusted__item">
                  <Icon name={x.icon} />
                  <span>{x.name}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ OUR APPROACH ============ -->
  <section class="section section--cream approach" aria-labelledby="approach-h">
    <div class="wrap approach__grid">
      <MediaSlot
        slot="home-approach"
        aspect="4 / 5"
        sizes="(min-width: 64rem) 40vw, 100vw"
        todo="Photo: brick shop exterior or press floor"
        class="approach__media"
      />
      <div>
        <p class="eyebrow">Our approach</p>
        <h2 id="approach-h">Tradition, capability, <em>what's next.</em></h2>
        <p class="lead">
          Since {site.foundingYear} we've paired old-school tool-and-die craft with modern equipment, so the parts you
          designed come back exactly the way you drew them.
        </p>
        <ul class="pillars">
          {
            approach.map((a) => (
              <li>
                <Icon name={a.icon} size={32} />
                <h3>{a.title}</h3>
                {a.sub && <p class="pillars__sub">{a.sub}</p>}
                <p>{a.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ DIVISIONS ============ -->
  <section class="section" id="divisions" aria-labelledby="divisions-h">
    <div class="wrap">
      <dl class="stats">
        <div><dt>Founded</dt><dd>{site.foundingYear}</dd></div>
        <div><dt>Years in business</dt><dd>{years}+</dd></div>
        <div><dt>Generation</dt><dd>3rd</dd></div>
        <div><dt>Divisions</dt><dd>{divisions.length}</dd></div>
      </dl>
      <div class="section-head">
        <p class="eyebrow">Four divisions</p>
        <h2 id="divisions-h">One shop. <em>Raw blank to finished part.</em></h2>
        <p class="lead">
          Because tooling, stamping and milling happen in-house, you deal with one supplier and one schedule.
        </p>
      </div>
      <div class="grid grid--4">
        {
          divisions.map((d, i) => (
            <article class="card division">
              <span class="label">Division 0{i + 1}</span>
              <h3>{d.name}</h3>
              <p>{d.summary}</p>
              <ul class="division__links">
                {liveLinks(d.links).map((l) => (
                  <li>
                    <a href={l.href}>{l.label} &rarr;</a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CAPABILITIES SNAPSHOT ============ -->
  <section class="section section--ink" aria-labelledby="caps-h">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Capabilities</p>
        <h2 id="caps-h">Built to print. <em>Held to spec.</em></h2>
        <p class="lead">Tool and die making, die striking, blanking, forming and CNC milling in one Pawtucket facility.</p>
        {
          isLive('/capabilities/') && (
            <a class="btn btn--ghost" href="/capabilities/">
              Full capabilities &amp; specs <span class="arr" aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
      <dl class="specs">
        <div>
          <dt>Processes</dt>
          <dd>Die striking, blanking, piercing, forming, CNC milling, in-house tool &amp; die <Todo>confirm list; add coining, progressive dies, etc. if applicable</Todo></dd>
        </div>
        <div>
          <dt>Press capacity</dt>
          <dd><Todo>press count and tonnage range, e.g. "12 presses, 20&ndash;300 tons"</Todo></dd>
        </div>
        <div>
          <dt>Materials</dt>
          <dd><Todo>confirm list, e.g. brass, copper, bronze, nickel silver, steel, stainless, aluminum, sterling</Todo></dd>
        </div>
        <div>
          <dt>Material thickness</dt>
          <dd><Todo>gauge / thickness range, e.g. ".005&Prime;&ndash;.125&Prime;"</Todo></dd>
        </div>
        <div>
          <dt>Tolerances</dt>
          <dd><Todo>typical and best-achievable tolerances, e.g. "&plusmn;.002&Prime; typical"</Todo></dd>
        </div>
        <div>
          <dt>Max part / blank size</dt>
          <dd><Todo>largest part or blank you can run</Todo></dd>
        </div>
        <div>
          <dt>Finishing</dt>
          <dd><Todo>in-house vs. outsourced finishes: plating, enamel, antiquing, polishing, etc.</Todo></dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section" aria-labelledby="process-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How a job runs</p>
        <h2 id="process-h">From print <em>to parts</em></h2>
      </div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step">
              <span class="step__n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ HERITAGE ============ -->
  <section class="section section--cream" aria-labelledby="heritage-h">
    <div class="wrap split heritage">
      <div>
        <p class="eyebrow">Since {site.foundingYear}</p>
        <h2 id="heritage-h">Three generations <em>on Roosevelt Avenue</em></h2>
        <p>
          Mel-Co-Ed has been stamping metal in Pawtucket, Rhode Island, since {site.foundingYear}, in a state that built
          its name on jewelry and metalworking. Today the company is run by the third generation of the same family.
        </p>
        <Todo block>
          2&ndash;3 sentences of founding story: who started Mel-Co-Ed, where the name comes from, and what the company
          first made. Real names and details here are what make this page rank and get cited.
        </Todo>
        <div class="heritage__marks">
          <Seal size={120} />
          <Seal mark="madeIn" size={120} />
        </div>
        {
          isLive('/about/') && (
            <a class="btn btn--ghost" href="/about/">
              Our story <span class="arr" aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
      <MediaSlot
        slot="home-heritage"
        aspect="4 / 3"
        sizes="(min-width: 56rem) 50vw, 100vw"
        todo="Photo: the vintage Mel-Co-Ed sign or a press-floor shot (min. 1600×1200)"
      />
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section" aria-labelledby="faq-h">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-h">Frequently asked</h2>
        {isLive('/faq/') && <p>More answers on our <a href="/faq/">FAQ page</a>.</p>}
      </div>
      <FaqList faqs={faqs} />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: 2.5rem 3rem;
    overflow: hidden;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .hero h1 {
    /* sized so the longest word ("craftsmanship") always fits its column */
    font-size: clamp(2.1rem, 8.6vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.005em;
  }
  .hero h1 em {
    display: block;
  }
  .hero .lead {
    margin-bottom: 0;
  }
  .hero__tagline {
    display: none;
  }
  @media (min-width: 64rem) {
    .hero {
      padding-block: 4.5rem 5rem;
    }
    .hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    .hero h1 {
      font-size: clamp(3.4rem, 4.15vw, 4.35rem);
    }
    .hero__text {
      position: relative;
      z-index: 1;
      padding-right: 1rem;
    }
    /* photo bleeds to the right edge and fades into the cream on its left */
    .hero :global(.hero__media) {
      margin-right: calc(var(--gutter) * -1 - 2.5rem);
    }
    .hero__tagline {
      display: block;
      position: absolute;
      right: calc(var(--gutter) * -1 + 0.25rem);
      top: 50%;
      margin: 0;
      writing-mode: vertical-rl;
      transform: translateY(-50%) rotate(180deg);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: var(--brass-text);
      white-space: nowrap;
    }
  }
  @media (min-width: 90rem) {
    .hero :global(.hero__media) {
      margin-right: -3rem;
    }
  }

  /* ---------- Tiles ---------- */
  .tiles-wrap {
    padding-bottom: 3.5rem;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 64rem) {
    .tiles {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
  }
  .tile {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }
  .tile :global(.media) {
    border: 1px solid var(--rule);
    transition: border-color var(--dur) var(--ease);
  }
  .tile :global(.media img) {
    transition: transform 600ms var(--ease);
  }
  a.tile:hover :global(.media) {
    border-color: var(--brass);
  }
  a.tile:hover :global(.media img) {
    transform: scale(1.02);
  }
  .tile__label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.85rem 0 0;
    border-top: 1px solid var(--brass);
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-transform: uppercase;
  }
  .tile__arrow {
    color: var(--oxblood);
    transition: transform var(--dur-fast) var(--ease);
  }
  a.tile:hover .tile__label {
    color: var(--oxblood);
  }
  a.tile:hover .tile__arrow {
    transform: translateX(2px);
  }
  @media (min-width: 48rem) {
    .tile__label {
      font-size: 1.02rem;
    }
  }

  /* ---------- Trusted strip ---------- */
  .trusted {
    padding-block: 2.75rem 3.25rem;
    border-top: 1px solid var(--rule);
  }
  .trusted__h {
    display: flex;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 0.7rem;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .trusted__h::after {
    content: '';
    flex: none;
    width: 1.75rem;
    height: 1px;
    background: var(--brass);
  }
  .trusted__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem 1rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }
  @media (min-width: 40rem) {
    .trusted__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 72rem) {
    .trusted__list {
      grid-template-columns: repeat(7, 1fr);
    }
  }
  .trusted__list a,
  .trusted__item {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    color: var(--ink-600);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease);
  }
  .trusted__list :global(.icon) {
    color: var(--brass);
  }
  .trusted__list a:hover {
    color: var(--oxblood);
  }

  /* ---------- Approach ---------- */
  .approach__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .approach__grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 5rem;
    }
  }
  .pillars {
    display: grid;
    gap: 2rem 2.5rem;
    margin: 2.5rem 0 0;
    padding: 2rem 0 0;
    list-style: none;
    border-top: 1px solid var(--brass);
  }
  @media (min-width: 40rem) {
    .pillars {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .pillars :global(.icon) {
    color: var(--brass);
    margin-bottom: 0.9rem;
  }
  .pillars h3 {
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }
  .pillars p {
    margin: 0;
    color: var(--ink-600);
    font-size: 0.97rem;
  }
  .pillars .pillars__sub {
    margin: -0.1rem 0 0.4rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--brass-text);
  }

  /* ---------- Stats ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0 0 4.5rem;
    border-top: 1px solid var(--brass);
    border-bottom: 1px solid var(--rule);
  }
  .stats > div {
    padding: 1.25rem 1rem 1.4rem 0;
  }
  .stats dt {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .stats dd {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 2.8rem);
    font-weight: 600;
    line-height: 1;
  }
  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
    .stats > div + div {
      padding-left: 1.5rem;
      border-left: 1px solid var(--rule);
    }
  }

  /* ---------- Divisions ---------- */
  .division__links {
    list-style: none;
    margin: auto 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--rule);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .division__links li + li {
    margin-top: 0.3rem;
  }
  .division__links a {
    text-decoration: none;
  }
  .division__links a:hover {
    text-decoration: underline;
  }

  /* ---------- Heritage ---------- */
  .heritage {
    align-items: center;
  }
  .heritage__marks {
    display: flex;
    gap: 1rem;
    margin: 0.5rem 0 1.75rem;
  }
  .heritage__marks :global(.seal) {
    width: 104px;
  }
</style>
