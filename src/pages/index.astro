---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaSlot from '../components/MediaSlot.astro';
import { site, quoteHref } from '../data/site';
import type { PhotoSlotName } from '../data/photos';

const families: { name: string; href: string; photo: PhotoSlotName; detail: string }[] = [
  { name: 'Badges & emblems', href: '/badges/', photo: 'badges', detail: 'Dimensional insignia, shield forms and custom emblems.' },
  { name: 'Medals & medallions', href: '/medallions/', photo: 'medallions', detail: 'Struck relief for recognition, commemoratives and award programs.' },
  { name: 'Findings & pattern stock', href: '/findings/', photo: 'findings', detail: 'Decorative components and textured metal for jewelry and accessories.' },
];
const guides = [
  ['How does die striking work?', 'what-is-die-striking'],
  ['What determines the cost of a custom die?', 'custom-stamping-die-cost'],
  ['Who owns the tooling for repeat orders?', 'who-owns-the-stamping-die'],
];
---
<BaseLayout title="Mel-Co-Ed | Ornamental Metal Stamping & Die Striking" fullTitle description="Ornamental metal stamping and die striking in Pawtucket, Rhode Island. Custom badges, medallions, emblems and jewelry findings, with in-house tooling since 1948.">
  <section class="wrap opening" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="kicker">Metal stamping &amp; die striking</p>
      <h1 id="hero-title">Ornamental<br /><em>metalwork.</em></h1>
      <p class="intro">We turn your artwork into die-struck badges, branded emblems, medallions and pins. Our Pawtucket toolmakers build the dies for your first run and the orders that follow.</p>
      <div class="btn-row"><a class="btn btn--primary" href={quoteHref}>Request a quote <span aria-hidden="true">↗</span></a><a class="plain" href="/capabilities/">Explore capabilities <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="hero-plate">
      <MediaSlot slot="home-hero" eager aspect="1.36" sizes="(min-width: 76rem) 650px, (min-width: 48rem) 50vw, 100vw" />
      <div class="photo-credit"><span>Embossed cuff bracelets in two finishes</span></div>
    </div>
  </section>

  <section class="product-area" aria-labelledby="product-heading">
    <div class="wrap">
      <div class="section-title"><div><p class="kicker">Products</p><h2 id="product-heading">What we make</h2></div><a class="plain" href="/products/">All products <span aria-hidden="true">→</span></a></div>
      <div class="products">{families.map(item =>
        <article>
          <a class="product-link" href={item.href}>
            <MediaSlot slot={item.photo} aspect="1.7" sizes="(min-width: 48rem) 31vw, 100vw" />
            <h3>{item.name}<span aria-hidden="true">↗</span></h3>
          </a>
          <p>{item.detail}</p>
        </article>
      )}</div>
      <div class="industrial"><strong>Industrial stamping</strong><span>Have a component to make to print?</span><a class="plain" href="/metal-stamping/">Review part requirements <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="shop">
    <div class="wrap shop-grid">
      <MediaSlot slot="home-services" aspect="1.23" sizes="(min-width:48rem) 45vw, 100vw" />
      <div>
        <p class="kicker">The Pawtucket tool room</p>
        <h2>From the first sample to the next production run.</h2>
        <p>Our toolmakers build and maintain the dies that give each part its shape and detail. We review the sample with you before production and keep the tooling available for the next release.</p>
        <a class="plain" href="/capabilities/product-development/">How we develop a part <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="wrap buyer">
    <div><p class="kicker">Buyer guides</p><h2>Before you order</h2>
    <p>Minimum quantities depend on the design, material and setup. We review your first release and expected reorders when we quote.</p><a class="plain" href="/resources/">All buyer guides <span aria-hidden="true">→</span></a></div>
    <div class="guide-list">{guides.map(([question, slug]) => <a href={`/resources/${slug}/`}>{question}<span aria-hidden="true">→</span></a>)}</div>
  </section>
</BaseLayout>
<style>
  .opening,.shop-grid,.buyer { display:grid; align-items:center; grid-template-columns:minmax(0,.94fr) minmax(0,1.06fr); gap:clamp(2rem,5vw,5rem); }
  .opening { padding-block:clamp(2.4rem,4.5vw,5rem); }
  .hero-copy { padding-block:1.3rem; }
  .kicker,.photo-credit { font:650 .72rem/1.4 var(--font-body); text-transform:uppercase; letter-spacing:.12em; }
  .kicker { color:var(--oxblood); margin:0 0 1.3rem; }
  .hero-copy .kicker { display:flex; align-items:center; gap:.8rem; }
  .hero-copy .kicker::before { content:''; width:2.1rem; height:2px; background:var(--oxblood); }
  h1 { margin:0; color:var(--navy); font-size:clamp(3.1rem,6.55vw,6rem); font-weight:800; line-height:.99; letter-spacing:-.065em; text-transform:none; }
  h1 em { font:italic 500 1.13em/.96 var(--font-serif); color:var(--oxblood); letter-spacing:-.066em; }
  .intro { max-width:39ch; font-size:clamp(1.04rem,1.4vw,1.23rem); margin:1.55rem 0 1.8rem; color:var(--ink-600); }
  .plain { display:inline-flex; align-items:center; gap:.7rem; color:var(--ink); text-decoration:underline; text-underline-offset:.37em; text-decoration-color:var(--brass); font-weight:650; font-size:.92rem; }
  .plain:hover { color:var(--oxblood); }
  .photo-credit { display:flex; justify-content:space-between; gap:1rem; padding:.7rem 0 0; color:var(--ink-600); font-size:.65rem; }
  .photo-credit span:last-child { text-align:right; font-weight:450; }
  .product-area { border-block:1px solid var(--rule); background:var(--paper); padding-block:clamp(3rem,5.5vw,5.5rem); }
  .section-title { display:flex; align-items:end; justify-content:space-between; gap:1rem; margin-bottom:1.6rem; }
  h2 { font:500 clamp(2.35rem,4vw,3.8rem)/1.04 var(--font-serif); letter-spacing:-.045em; margin:0; }
  .section-title .kicker,.buyer .kicker { margin-bottom:.6rem; }
  .products { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(1rem,2.3vw,2.1rem); }
  .product-link { display:block; text-decoration:none; color:var(--ink); }
  .product-link:hover h3 { color:var(--oxblood); }
  .products h3 { display:flex; align-items:baseline; justify-content:space-between; gap:.6rem; font-size:clamp(1.15rem,1.7vw,1.55rem); margin:1rem 0 .35rem; }
  .products h3 span { flex:none; font-size:1.1rem; color:var(--oxblood); }
  article p,.industrial,.buyer p:not(.kicker) { color:var(--ink-600); }
  article p { margin:0; font-size:.98rem; max-width:38ch; }
  .industrial { display:flex; align-items:center; flex-wrap:wrap; gap:.4rem 1.1rem; margin-top:2.4rem; padding-top:1.3rem; border-top:1px solid var(--rule); font-size:.95rem; }
  .industrial strong { color:var(--navy); }
  .industrial a { margin-left:auto; }
  .shop { background:var(--navy); color:var(--cream); }
  .shop-grid,.buyer { padding-block:clamp(3rem,6.5vw,6rem); }
  .shop h2 { color:var(--paper); max-width:17ch; }
  .shop .kicker { color:var(--brass-light); }
  .shop p:not(.kicker) { color:#e2dfd6; margin:1.3rem 0; max-width:49ch; }
  .shop a { color:var(--cream); }
  .buyer p:not(.kicker) { max-width:45ch; margin:1rem 0; }
  .guide-list a { display:flex; align-items:center; justify-content:space-between; gap:1rem; text-decoration:none; border-top:1px solid var(--rule); padding:1.2rem 0; font-weight:600; color:var(--ink); }
  .guide-list a:last-child { border-bottom:1px solid var(--rule); }
  .guide-list a:hover,.guide-list span { color:var(--oxblood); }
  @media(max-width:47.99rem) {
    .opening,.shop-grid,.buyer,.products { grid-template-columns:minmax(0,1fr); }
    .opening { gap:1.8rem; } .hero-copy { padding:0; } h1 { font-size:clamp(3.25rem,10vw,4.7rem); }
    .opening :global(.media) { max-height:24rem; } .intro { margin:1rem 0 1.35rem; }
    .products { gap:2rem; } .section-title { flex-wrap:wrap; }
    .industrial { display:grid; gap:.5rem; } .industrial a { margin-left:0; }
    .shop-grid {gap:1.6rem;} .shop-grid > div {grid-row:1;}
  }
</style>
