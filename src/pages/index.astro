---
// Home: seven sections, centered on metal stamping for every industry.
// Hero (with product tiles) → Services → Industries → Two ways to buy → Why Mel-Co-Ed
// → Heritage → CTA (the footer's quote band).
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaSlot from '../components/MediaSlot.astro';
import Icon from '../components/Icon.astro';
import Seal from '../components/Seal.astro';
import Testimonials from '../components/Testimonials.astro';
import CatalogLinks from '../components/CatalogLinks.astro';
import { site, quoteHref } from '../data/site';
import { madeIn } from '../data/brand';
import { isLive } from '../lib/routes';
import { industries } from '../data/industries';
import { services } from '../data/services';
import { confidential } from '../data/confidential';
import type { PhotoSlotName } from '../data/photos';
import { waysToBuy, ordering } from '../data/facts';

const years = new Date().getFullYear() - site.foundingYear;
const homeServices = services.filter((s) => s.home !== false);

// Product tiles under the hero, industrial first (photos come from each product's slot).
const tiles: { label: string; href: string; slot: PhotoSlotName }[] = [
  { label: 'Metal Stamping', href: '/metal-stamping/', slot: 'metal-stamping' },
  { label: 'Findings', href: '/findings/', slot: 'findings' },
  { label: 'Emblems & Badges', href: '/badges/', slot: 'badges' },
  { label: 'Medallions & Awards', href: '/medallions/', slot: 'medallions' },
];

const why = [
  {
    icon: 'die' as const,
    title: 'Tooling in-house',
    body: 'Dies are designed, built and maintained in our own tool room, so changes and reruns stay on our schedule.',
  },
  {
    icon: 'pin' as const,
    title: madeIn.primary,
    body: `Made in Rhode Island since ${site.foundingYear}, on Roosevelt Avenue in Pawtucket since 1964. ${madeIn.secondary}.`,
  },
  {
    icon: 'hand' as const,
    title: 'Third generation',
    body: 'Family-owned and run by the third generation, in Rhode Island for more than seven decades.',
  },
];
---

<BaseLayout
  title={`${site.name} | Metal Stamping & Die Striking in Pawtucket, RI Since ${site.foundingYear}`}
  fullTitle
  description={`Progressive, transfer and automatic metal stamping, coining and die striking, with tooling built in-house. Any metal, any industry. Made in Rhode Island, USA since ${site.foundingYear}.`}
>
  <!-- 1. HERO + product tiles -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1>Metal stamping &amp; die striking. <em>Since {site.foundingYear}.</em></h1>
        <p class="lead">
          Progressive, transfer and automatic stamping, coining and die striking, with tooling built in our own tool
          room. Any metal. Any industry. {madeIn.primary}.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={quoteHref}>Request a quote <span class="arr" aria-hidden="true">→</span></a>
          <a class="text-link" href={`tel:${site.phone.e164}`}>or call {site.phone.display}</a>
        </div>
      </div>
      <MediaSlot
        slot="home-hero"
        aspect="5 / 4"
        eager
        sizes="(min-width: 64rem) 55vw, 100vw"
        todo="Hero photo: the press floor"
        class="hero__media"
      />
    </div>
    <div class="wrap">
      <ul class="tiles" aria-label="Products">
        {
          tiles.map((t) => {
            const inner = (
              <span class="tile__label">
                {t.label} <span class="tile__arrow" aria-hidden="true">→</span>
              </span>
            );
            return <li>{isLive(t.href) ? <a class="tile" href={t.href}>{inner}</a> : <div class="tile">{inner}</div>}</li>;
          })
        }
      </ul>
    </div>
  </section>

  <!-- 2. SERVICES -->
  <section class="section section--cream" aria-labelledby="services-h">
    <div class="wrap">
      <div class="head-row">
        <h2 id="services-h">Services</h2>
        {isLive('/capabilities/') && <a class="text-link" href="/capabilities/">All capabilities &rarr;</a>}
      </div>
      <div class="services-wrap">
        <MediaSlot slot="home-services" aspect="4 / 5" sizes="(min-width: 64rem) 40vw, 100vw" todo="Photo" class="services__photo" />
        <ul class="services">
          {
            homeServices.map((s) => (
              <li>
                <a class="service" href={s.href}>
                  <h3>{s.label} <span class="tile__arrow" aria-hidden="true">→</span></h3>
                  <p>{s.summary}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. INDUSTRIES -->
  <section class="section" aria-labelledby="industries-h">
    <div class="wrap">
      <div class="head-row">
        <h2 id="industries-h">Stamping for <em>every industry</em></h2>
        {isLive('/industries/') && <a class="text-link" href="/industries/">All industries &rarr;</a>}
      </div>
      <ul class="ind-strip">
        {
          industries.map((x) => (
            <li>
              {isLive(x.href) ? (
                <a href={x.href}>
                  <Icon name={x.icon} size={40} />
                  <span>{x.name}</span>
                </a>
              ) : (
                <span class="ind-strip__item">
                  <Icon name={x.icon} size={40} />
                  <span>{x.name}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. TWO WAYS TO BUY + confidentiality -->
  <section class="section section--cream" aria-labelledby="ways-h">
    <div class="wrap">
      <h2 id="ways-h">Two ways <em>to buy</em></h2>
      <div class="ways__grid">
        {
          waysToBuy.map((w, i) => (
            <article class="ways__card">
              <span class="ways__n">0{i + 1}</span>
              <h3>{w.name}</h3>
              <p>{w.summary}</p>
              {w.name === 'Confined & Custom' && isLive('/capabilities/product-development/') && (
                <a class="ways__more" href="/capabilities/product-development/">How custom development works &rarr;</a>
              )}
            </article>
          ))
        }
      </div>
      <p class="confidential-line">
        <strong>{confidential.heading} {confidential.accent}</strong>
        {confidential.body}
      </p>
      <dl class="terms">
        <div><dt>Minimum</dt><dd>{ordering.minimum}. {ordering.noMinimum}</dd></div>
        <div><dt>Lead time</dt><dd>Typically {ordering.leadTime}</dd></div>
        <div><dt>Pricing</dt><dd>{ordering.pricing}</dd></div>
      </dl>
      <div class="btn-row ways__cta">
        <a class="btn btn--primary" href={quoteHref}>Request a quote <span class="arr" aria-hidden="true">→</span></a>
        <CatalogLinks variant="links" todo />
      </div>
    </div>
  </section>

  <!-- 5. WHY MEL-CO-ED -->
  <section class="section section--ink" aria-labelledby="why-h">
    <div class="wrap">
      <h2 id="why-h">Why <em>Mel-Co-Ed</em></h2>
      <ul class="why">
        {
          why.map((w) => (
            <li>
              <Icon name={w.icon} size={36} />
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </li>
          ))
        }
      </ul>
      <dl class="stats">
        <div><dt>Founded</dt><dd>{site.foundingYear}</dd></div>
        <div><dt>Years stamping</dt><dd>{years}+</dd></div>
        <div><dt>Open-line findings</dt><dd>30,000+</dd></div>
        <div><dt>Die striking</dt><dd>3.5″</dd></div>
      </dl>
    </div>
  </section>

  <!-- Testimonials: hidden until src/data/testimonials.ts has one -->
  <Testimonials />

  <!-- 6. HERITAGE -->
  <section class="section" aria-labelledby="heritage-h">
    <div class="wrap split heritage">
      <div>
        <Seal size={120} />
        <h2 id="heritage-h">Three generations <em>on Roosevelt Avenue</em></h2>
        <p>
          Stamping metal in Pawtucket, Rhode Island since {site.foundingYear}, in the historic jewelry capital of the
          world. Still family-owned, now in the third generation.
        </p>
        {isLive('/about/') && <a class="text-link" href="/about/">Our story &rarr;</a>}
      </div>
      <MediaSlot
        slot="home-heritage"
        aspect="4 / 3"
        sizes="(min-width: 56rem) 50vw, 100vw"
        todo="Photo: the building or the vintage sign"
      />
    </div>
  </section>
  <!-- 7. CTA: the footer's quote band -->
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: 2.5rem 3.5rem;
    overflow: hidden;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .hero h1 em {
    display: block;
  }
  .hero .lead {
    margin-bottom: 1.75rem;
  }
  @media (min-width: 64rem) {
    .hero {
      padding-block: 4rem 5rem;
    }
    .hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    .hero__text {
      position: relative;
      z-index: 1;
      padding-right: 2rem;
    }
    /* photo bleeds to the right edge, hard left edge */
    .hero :global(.hero__media) {
      margin-right: calc(var(--gutter) * -1 - 2.5rem);
    }
  }
  @media (min-width: 90rem) {
    .hero :global(.hero__media) {
      margin-right: -3rem;
    }
  }

  /* ---------- Product tiles ---------- */
  .tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .tiles {
      grid-template-columns: repeat(4, 1fr);
      margin-top: var(--space-6);
    }
  }
  .tile {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }
  .tile :global(.media img),
  .service :global(.media img) {
    transition: transform 600ms var(--ease);
  }
  a.tile:hover :global(.media img),
  .service:hover :global(.media img) {
    transform: scale(1.02);
  }
  .tile__label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1);
    padding: var(--space-2) 0;
    border-top: 1px solid var(--rule);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.25;
  }
  .tile__illus {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--ink-600);
  }
  .tile__illus strong {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .tile__arrow {
    color: var(--oxblood);
    transition: transform var(--dur-fast) var(--ease);
  }
  a.tile:hover .tile__label {
    color: var(--oxblood);
  }
  a.tile:hover .tile__arrow,
  .service:hover .tile__arrow {
    transform: translateX(2px);
  }

  /* ---------- Section heads with one link ---------- */
  .head-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    margin-bottom: 2rem;
  }
  .head-row h2 {
    margin: 0;
  }

  /* ---------- Services ---------- */
  .services-wrap {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 56rem) {
    .services-wrap {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-6);
      align-items: start;
    }
  }
  .services {
    display: grid;
    gap: 0 var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .services li {
    border-top: 1px solid var(--rule);
  }
  .service {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }
  .service {
    padding: var(--space-3) 0 var(--space-4);
  }
  .service h3 {
    display: flex;
    justify-content: space-between;
    gap: var(--space-1);
    margin: 0 0 var(--space-1);
  }
  .service p {
    margin: 0;
    color: var(--ink-600);
  }
  .service:hover h3 {
    color: var(--oxblood);
  }

  /* ---------- Industries strip ---------- */
  .ind-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }
  @media (min-width: 40rem) {
    .ind-strip {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .ind-strip a,
  .ind-strip__item {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    color: var(--ink-600);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.45;
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease);
  }
  .ind-strip :global(.icon) {
    color: var(--brass);
  }
  .ind-strip a:hover {
    color: var(--oxblood);
  }

  /* ---------- Two ways to buy ---------- */
  .ways__grid {
    display: grid;
    gap: var(--space-4) var(--space-5);
    margin-top: var(--space-5);
  }
  @media (min-width: 48rem) {
    .ways__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ways__card {
    padding-top: var(--space-3);
    border-top: 1px solid var(--ink);
  }
  .ways__n {
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    color: var(--oxblood);
  }
  .ways__card h3 {
    font-size: var(--fs-h3);
  }
  .ways__card p {
    margin: 0;
    color: var(--ink-600);
  }
  .ways__more {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
  }
  .confidential-line {
    margin: var(--space-5) 0 0;
    color: var(--ink-600);
  }
  .confidential-line strong {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }
  .terms {
    display: grid;
    margin: var(--space-5) 0 0;
    border-top: 1px solid var(--rule);
  }
  .terms > div {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .terms dt {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .terms dd {
    margin: 0.3rem 0 0;
    color: var(--ink-600);
  }
  @media (min-width: 56rem) {
    .terms {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 1.5rem;
    }
  }
  .ways__cta {
    margin-top: var(--space-5);
    align-items: flex-start;
  }

  /* ---------- Why ---------- */
  .why {
    display: grid;
    gap: 2rem 3rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .why {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .why :global(.icon) {
    color: var(--brass-light);
    margin-bottom: 1rem;
  }
  .why h3 {
    color: var(--paper);
  }
  .why p {
    margin: 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 3.5rem 0 0;
    border-top: 1px solid var(--rule-dark);
  }
  .stats > div {
    padding: 1.25rem 1rem 0 0;
  }
  .stats dt {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass-light);
  }
  .stats dd {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1;
    color: var(--paper);
  }
  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---------- Heritage ---------- */
  .heritage {
    align-items: center;
  }
  .heritage :global(.seal) {
    width: 104px;
    margin-bottom: 1.5rem;
  }
</style>
