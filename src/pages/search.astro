---
// Site search, powered by Pagefind: the index is built from dist/ at deploy time
// (`pagefind --site dist` in the build script), so it needs no server or service.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<BaseLayout title="Search" description="Search the Mel-Co-Ed, Inc. website." noindex hideFooterCta>
  <PageHero title="Search" ribbon="Find it fast" lead="Products, capabilities, industries and answers." />
  <section class="section search-section">
    <div class="wrap">
      <div id="search"></div>
      <noscript>
        <p>Search needs JavaScript. You can also call us at <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>.</p>
      </noscript>
    </div>
  </section>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      // eslint-disable-next-line no-undef
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false, autofocus: true });
    });
  </script>
</BaseLayout>

<style>
  .search-section {
    padding-top: 2.5rem;
    min-height: 50vh;
  }
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--oxblood);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--bone);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 2px;
    --pagefind-ui-font: var(--font-body);
    max-width: 52rem;
  }
  #search :global(.pagefind-ui__result-title) {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  #search :global(mark) {
    background: #f3e3ae;
    color: inherit;
  }
</style>
