---
// Mel-Co-Ed at a Glance: 2 pages (front/back, US Letter), laid out like the original printed sheet:
// black bands, gold accents, condensed headlines. Print layout only: no site header/footer.
// The PDF in public/downloads/ is exported from this page: `npm run at-a-glance`.
// Rules: never say "finished in-house" (plating, polishing and enamel are done by outside
// finishers), no castings, no customer pieces in photos, no factory-floor photos, sales@ only.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/inter/wght.css';
import { Image } from 'astro:assets';
import { site, fullAddress, quoteHref } from '../data/site';
import qrSvg from '../assets/brand/qr-request-a-quote.svg?raw';
import brassBlanks from '../assets/photos/brass-blanks.jpg';
import findingsFloral from '../assets/photos/findings-floral-stampings.jpg';
import patternStock from '../assets/photos/pattern-stock.jpg';
import tieBars from '../assets/photos/tie-bars.jpg';
import cuffsTextured from '../assets/photos/cuffs-textured.jpg';
import cufflinksFootball from '../assets/photos/cufflinks-football.jpg';
import flagPin from '../assets/photos/flag-pin-front.jpg';
import cuffsEmbossed from '../assets/photos/cuffs-embossed.jpg';
import pins from '../assets/at-a-glance/pins-skull-anchor.jpg';
import tray from '../assets/at-a-glance/cufflink-tray.jpg';
import banner from '../assets/at-a-glance/banner-assortment.jpg';
import showroom from '../assets/photos/showroom-wall.jpg';

const grid = [
  { src: patternStock, alt: 'Embossed brass pattern stock and banding' },
  { src: tieBars, alt: 'Tie bars in gold, silver and antique finishes' },
  { src: cuffsTextured, alt: 'Textured cuff bracelets' },
  { src: pins, alt: 'Anchor and skull lapel pins' },
  { src: cufflinksFootball, alt: 'Football cufflinks in antique brass' },
  { src: flagPin, alt: 'Enameled American flag lapel pin' },
  { src: cuffsEmbossed, alt: 'Embossed cuff bracelets in brass and silver' },
  { src: tray, alt: 'A tray of cufflinks' },
];
const web = site.url.replace('https://www.', '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Mel-Co-Ed at a Glance</title>
    <link rel="canonical" href={`${site.url}/at-a-glance/`} />
  </head>
  <body class="ataglance">
    <!-- ================= FRONT ================= -->
    <section class="sheet" aria-label="Mel-Co-Ed at a Glance, front">
      <header class="hero">
        <div class="hero__text">
          <div class="brand">
            <span class="mark">MCE</span>
            <span>
              <span class="brand__name">Mel-Co-Ed, Inc.</span>
              <span class="brand__sub">Pawtucket, Rhode Island · Since 1948</span>
            </span>
          </div>
          <h1>Coined. Die struck. Stamped. Since 1948.</h1>
          <p>
            Third-generation, family-owned maker of custom die-struck emblems, jewelry findings and stampings in
            Southern New England, the historic jewelry capital of the world. Full tool room on site — from your
            sketch, drawing or sample to finished, packed parts.
          </p>
        </div>
        <div class="hero__photo">
          <Image src={brassBlanks} alt="Freshly stamped brass blanks" width={900} loading="eager" />
          <div class="usa">★ Made in the USA ★</div>
        </div>
      </header>

      <div class="body">
        <h2 class="eyebrow">Custom &amp; Confined — what we do best</h2>
        <div class="custom">
          <Image src={findingsFloral} alt="Die-struck floral findings in gold" width={700} />
          <div class="custom__text">
            <h3>Your design. Your die. Run only for you.</h3>
            <p>Send a sketch, drawing or sample. We engineer it, prototype it, cut the die in our own tool room and strike it here in Pawtucket.</p>
            <p class="gold">You own your die — stored free, take it anywhere.</p>
            <p class="strong">Already have dies or metal? We’ll run yours.</p>
          </div>
        </div>

        <div class="openline">
          <Image src={showroom} alt="Our findings showroom in Pawtucket" width={400} />
          <h3>Open Line</h3>
          <p>30,000+ stock findings, stampings and pattern stock, no tooling cost. Pick from our catalogs, or design around one of our patterns.</p>
        </div>

        <h2 class="eyebrow">What we make</h2>
        <div class="tiles">{grid.map((g) => <Image src={g.src} alt={g.alt} width={480} />)}</div>
      </div>

      <p class="strapline">Made in the USA · All metals available · Prototypes before you commit · 3–8 week lead time · Specs on the back</p>
      <footer class="foot">
        <span>{fullAddress}</span>
        <strong class="gold">{site.phone.display}</strong>
        <span>{site.email}</span>
        <strong>{web}</strong>
      </footer>
    </section>

    <!-- ================= BACK ================= -->
    <section class="sheet" aria-label="Mel-Co-Ed at a Glance, back">
      <header class="top">
        <div class="top__left">
          <div class="top__title"><span class="mark">MCE</span><h1>Built to Your Spec</h1></div>
          <div class="top__strip">★ Made in the USA · Pawtucket, Rhode Island</div>
        </div>
        <Image src={banner} alt="Bracelet, cufflinks, tie bar and flag pin" width={1229} class="top__photo" loading="eager" />
      </header>

      <div class="body cols">
        <div>
          <h2 class="eyebrow">What we do</h2>
          <p>Coining · Die striking · Progressive, transfer &amp; automatic stamping · Embossed pattern stock &amp; banding · Tool &amp; die · Prototyping · Finishing &amp; plating · Assembly &amp; packaging · Precision milling</p>
          <h2 class="eyebrow">Presses &amp; tolerances</h2>
          <p>20+ presses: 25–250 ton automatic, 5–25 ton secondary. Stamping .010″–.250″ stock, ±.002″ typical. Die striking up to 3.5″ diameter, up to .250″ thick.</p>
        </div>
        <div>
          <h2 class="eyebrow">Materials</h2>
          <p>Brass (230 / 260) · Copper · Nickel silver · Sterling silver · Fine silver · Gold &amp; gold filled · Stainless steel · Aluminum · Cold-rolled steel · Zinc</p>
          <p class="strong">All metals available — or send us yours.</p>
          <h2 class="eyebrow">Finishes</h2>
          <p>High polish · Satin · Sandblast · Antique · Color fill · Plating: gold, karat gold, silver, imitation rhodium</p>
        </div>
      </div>

      <div class="body">
        <div class="pack">
          <div>
            <h2 class="eyebrow">Packaging &amp; logistics</h2>
            <p class="pack__h">Done here, not by you.</p>
          </div>
          <p>Assembly · Custom packaging · UPC &amp; RFID tagging · Inventory held for you · Drop ship direct to your customers. Hand us the whole job and never touch a box.</p>
        </div>

        <div class="order">
          <h2>How to Order</h2>
          <dl>
            <div><dt>Minimum:</dt> <dd>3 gross per item. Smaller runs at a higher price. No minimums on sterling silver or gold.</dd></div>
            <div><dt>Lead time:</dt> <dd>3–8 weeks, depending on the job.</dd></div>
            <div><dt>Pricing:</dt> <dd>Quoted at time of order on current metal prices.</dd></div>
            <div><dt>Custom work:</dt> <dd>Quoted per job. Send a sketch, drawing or sample.</dd></div>
          </dl>
        </div>

        <p class="serve"><strong>Who we serve:</strong> Jewelry &amp; fashion · Military, police, fire &amp; government · Fraternal &amp; lodge · Recognition &amp; awards · Corporate gifts · Religious goods · Golf &amp; sports</p>
        <p class="serve"><strong>Catalogs:</strong> Findings &amp; Stampings Catalog · Pattern &amp; Banding Catalog</p>
      </div>

      <footer class="foot foot--back">
        <div class="qr" set:html={qrSvg} aria-hidden="true" />
        <div>
          <a class="cta" href={`${site.url}${quoteHref}`}>Request a quote</a>
          <span class="muted">{fullAddress}<br />Made in the USA since 1948</span>
        </div>
        <div class="right">
          <strong>{site.phone.display}</strong>
          <span>{site.email} · <strong>{web}</strong></span>
        </div>
      </footer>
    </section>
  </body>
</html>

<style is:global>
  /* Scoped to body.ataglance: Astro can bundle this stylesheet onto other pages. */
  .ataglance  {
    --black: #141414;
    --gold: #c9a24a;
    --gold-text: #8a6a1f;
    --paper: #ffffff;
    --ink: #1b1b1b;
    --ink-600: #4a4a4a;
    --rule: #e3ded3;
    --display: 'Archivo Variable', Archivo, 'Arial Narrow', Arial, sans-serif;
    --body: 'Inter Variable', Inter, system-ui, Arial, sans-serif;
  }
  @page ataglance {
    size: letter;
    margin: 0;
  }
  .ataglance *  {
    box-sizing: border-box;
  }
  html:has(body.ataglance),
  body.ataglance  {
    margin: 0;
    background: #8e9399;
    color: var(--ink);
    font: 11pt/1.45 var(--body);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .ataglance .sheet {
    page: ataglance;
    display: flex;
    flex-direction: column;
    width: 8.5in;
    height: 11in;
    margin: 0.4in auto;
    overflow: hidden;
    background: var(--paper);
    box-shadow: 0 6px 30px rgb(0 0 0 / 0.35);
  }
  @media print {
    html:has(body.ataglance),
  body.ataglance  {
      background: none;
    }
    .ataglance .sheet  {
      margin: 0;
      box-shadow: none;
      break-after: page;
    }
  }
  .ataglance h1,
  .ataglance h2,
  .ataglance h3  {
    margin: 0;
    font-family: var(--display);
    font-stretch: 75%;
    font-weight: 700;
    line-height: 1.05;
  }
  .ataglance p  {
    margin: 0;
  }
  .ataglance img  {
    display: block;
    width: 100%;
    object-fit: cover;
    min-height: 0;
  }
  .ataglance .gold  {
    color: var(--gold);
  }
  .ataglance .strong  {
    font-weight: 700;
  }
  .ataglance .body  {
    padding: 0 0.55in;
  }
  .ataglance .eyebrow  {
    margin: 0.24in 0 0.1in;
    font-size: 11pt;
    font-stretch: 75%;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .ataglance .mark  {
    display: inline-grid;
    place-items: center;
    width: 0.62in;
    height: 0.62in;
    border: 2.5px solid #fff;
    font-family: var(--display);
    font-stretch: 75%;
    font-weight: 800;
    font-size: 17pt;
    color: #fff;
    flex: none;
  }

  /* Front */
  .ataglance .hero {
    display: grid;
    grid-template-columns: 1fr 3.1in;
    height: 3.15in;
    background: var(--black);
    color: #fff;
    border-bottom: 5px solid var(--gold);
  }
  .ataglance .hero__text  {
    padding: 0.36in 0.35in 0.3in 0.55in;
  }
  .ataglance .brand  {
    display: flex;
    align-items: center;
    gap: 0.16in;
    margin-bottom: 0.24in;
  }
  .ataglance .brand__name  {
    display: block;
    font-family: var(--display);
    font-stretch: 85%;
    font-weight: 800;
    font-size: 17pt;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ataglance .brand__sub  {
    display: block;
    font-family: var(--display);
    font-stretch: 85%;
    font-weight: 600;
    font-size: 9pt;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .ataglance .hero h1  {
    margin-bottom: 0.18in;
    font-size: 27pt;
  }
  .ataglance .hero p  {
    font-size: 10pt;
    color: #e8e8e8;
  }
  .ataglance .hero__photo img  {
    height: 100%;
  }
  .ataglance .hero__photo  {
    position: relative;
    height: calc(3.15in - 5px);
    overflow: hidden;
    border-left: 5px solid var(--gold);
  }
  .ataglance .usa  {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.1in;
    background: var(--black);
    color: var(--gold);
    font-family: var(--display);
    font-stretch: 75%;
    font-weight: 700;
    font-size: 15pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
  }
  .ataglance .custom  {
    display: grid;
    grid-template-columns: 3.2in 1fr;
    height: 1.95in;
    overflow: hidden;
  }
  .ataglance .custom img  {
    height: 1.95in;
  }
  .ataglance .custom__text  {
    padding: 0.18in 0.26in;
    background: var(--black);
    color: #fff;
    border-left: 5px solid var(--gold);
  }
  .ataglance .custom__text h3  {
    margin-bottom: 0.1in;
    font-size: 19pt;
    color: var(--gold);
  }
  .ataglance .custom__text p  {
    font-size: 10pt;
    margin-bottom: 0.07in;
  }
  .ataglance .custom__text .gold  {
    font-weight: 700;
  }
  .ataglance .openline  {
    display: grid;
    grid-template-columns: 1.4in auto 1fr;
    align-items: center;
    gap: 0.25in;
    height: 0.9in;
    margin-top: 0.18in;
    overflow: hidden;
    border: 2px solid var(--black);
  }
  .ataglance .openline img  {
    width: 100%;
    height: calc(0.9in - 4px);
    object-fit: cover;
    object-position: 50% 30%;
  }
  .ataglance .openline h3  {
    font-size: 21pt;
    white-space: nowrap;
  }
  .ataglance .openline p  {
    padding-right: 0.25in;
    font-size: 10.5pt;
  }
  .ataglance .tiles  {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.13in;
  }
  .ataglance .tiles img  {
    height: 1.16in;
    border: 1px solid var(--rule);
  }
  .ataglance .strapline  {
    margin-top: auto;
    padding: 0 0.55in 0.14in;
    font-size: 9.5pt;
    color: var(--ink-600);
  }
  .ataglance .foot  {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.2in;
    padding: 0.2in 0.55in;
    background: var(--black);
    color: #fff;
    font-size: 10.5pt;
  }

  /* Back */
  .ataglance .top {
    display: grid;
    grid-template-columns: 4.35in 1fr;
    height: 1.95in;
    overflow: hidden;
  }
  .ataglance .top__left  {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--black);
  }
  .ataglance .top__title  {
    display: flex;
    align-items: center;
    gap: 0.2in;
    padding: 0.38in 0.3in 0 0.55in;
  }
  .ataglance .top__title h1  {
    font-size: 28pt;
    white-space: nowrap;
    color: #fff;
  }
  .ataglance .top__strip  {
    padding: 0.1in 0.2in 0.1in 0.55in;
    background: var(--gold);
    color: var(--black);
    font-family: var(--display);
    font-stretch: 80%;
    font-weight: 700;
    font-size: 10pt;
    letter-spacing: 0.08em;
    white-space: nowrap;
    text-transform: uppercase;
  }
  .ataglance .top__photo  {
    height: 1.95in;
  }
  .ataglance .cols  {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45in;
  }
  .ataglance .cols p  {
    margin-bottom: 0.06in;
    font-size: 10.5pt;
  }
  .ataglance .pack  {
    display: grid;
    grid-template-columns: 2.5in 1fr;
    gap: 0.25in;
    align-items: center;
    margin-top: 0.26in;
    padding: 0.02in 0.26in 0.18in;
    border: 2px solid var(--gold);
  }
  .ataglance .pack .eyebrow  {
    margin-top: 0.16in;
    margin-bottom: 0.04in;
  }
  .ataglance .pack__h  {
    font-family: var(--display);
    font-stretch: 75%;
    font-weight: 700;
    font-size: 19pt;
    line-height: 1.05;
  }
  .ataglance .pack > p  {
    padding-top: 0.12in;
    font-size: 10.5pt;
  }
  .ataglance .pack .eyebrow  {
    white-space: nowrap;
  }
  .ataglance .order  {
    margin-top: 0.26in;
    padding: 0.2in 0.3in 0.22in;
    background: var(--black);
    color: #fff;
  }
  .ataglance .order h2  {
    margin-bottom: 0.12in;
    font-size: 21pt;
    color: var(--gold);
  }
  .ataglance .order dl  {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.1in 0.4in;
    margin: 0;
    font-size: 10.5pt;
  }
  .ataglance .order dt,
  .ataglance .order dd  {
    display: inline;
    margin: 0;
  }
  .ataglance .order dt  {
    font-weight: 700;
  }
  .ataglance .serve  {
    margin-top: 0.2in;
    font-size: 10pt;
    color: var(--ink-600);
  }
  .ataglance .serve + .serve  {
    margin-top: 0.08in;
  }
  .ataglance .serve strong  {
    color: var(--ink);
  }
  .ataglance .foot--back  {
    margin-top: auto;
    padding: 0.2in 0.55in 0.24in;
    border-top: 5px solid var(--gold);
  }
  .ataglance .qr  {
    width: 0.95in;
    height: 0.95in;
    padding: 0.05in;
    background: #faf7f1;
    flex: none;
  }
  .ataglance .qr svg  {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Middle column takes the leftover width and wraps; the contact block on the right never
     shrinks, so the phone, email and web address always sit inside the 0.55in margin. */
  .ataglance .foot--back > div:nth-child(2)  {
    flex: 1 1 auto;
    min-width: 0;
  }
  .ataglance .cta  {
    display: block;
    font-family: var(--display);
    font-stretch: 75%;
    font-weight: 700;
    font-size: 22pt;
    color: var(--gold);
    text-decoration: none;
  }
  .ataglance .muted  {
    display: block;
    font-size: 9.5pt;
    color: #cfcfcf;
  }
  .ataglance .right  {
    flex: none;
    display: grid;
    white-space: nowrap;
    text-align: right;
  }
  .ataglance .right > strong  {
    font-family: var(--display);
    font-stretch: 85%;
    font-size: 16pt;
  }
</style>
