---
import { Image } from 'astro:assets';
import { site, fullAddress, quoteHref } from '../data/site';
import { atAGlance } from '../data/downloads';
import floral from '../assets/photos/findings-floral-stampings.jpg';
import pattern from '../assets/photos/pattern-stock.jpg';
import qrCode from '../assets/brand/qr-request-a-quote.svg?raw';

const capabilities = [
  ['Ornamental stamping', 'Custom badges, emblems, medallions, pins and awards. Open Line findings and embossed pattern stock are also available for product collections.'],
  ['Tooling & development', 'Our Pawtucket tool room builds and maintains dies. Start with artwork, a drawing or an existing sample. We review the relief, edges and attachment before tooling.'],
  ['Industrial components', 'Progressive and single-operation stamping for parts suited to our presses. Include the grade, stock thickness, critical tolerances and mating features.'],
  ['Materials & finishes', 'Options include brass, copper, nickel silver, sterling silver and selected steels. We coordinate polishing, plating and color fill with finishing partners.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content="A printable overview of Mel-Co-Ed’s ornamental stamping, tooling, materials and quote requirements." />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={`${site.url}/at-a-glance/`} />
    <title>Mel-Co-Ed at a Glance</title>
  </head>
  <body>
    <nav class="utility" aria-label="Sheet navigation">
      <a href="/">Back to Mel-Co-Ed</a>
      {atAGlance && <a href={atAGlance.href} download>Download buyer sheet (PDF)</a>}
    </nav>
    <main>
      <header>
        <p class="wordmark">Mel-Co-Ed<span>, Inc.</span></p>
        <p class="origin">Pawtucket, Rhode Island <span>Since 1948</span></p>
      </header>
      <section class="intro" aria-labelledby="sheet-title">
        <h1 id="sheet-title">Ornamental metal stamping<br /> &amp; die striking</h1>
        <p>Third-generation, family-owned manufacturer of decorative metalwork and industrial components. We develop tooling, strike samples and run repeat orders in Pawtucket.</p>
      </section>
      <div class="pictures">
        <figure>
          <Image src={floral} width={950} format="webp" alt="Floral Open Line stampings with raised petals and leaf veins" />
          <figcaption>Open Line floral stampings</figcaption>
        </figure>
        <figure>
          <Image src={pattern} width={650} format="webp" alt="Brass banding with embossed patterns" />
          <figcaption>Embossed pattern stock</figcaption>
        </figure>
      </div>
      <section class="details" aria-label="Manufacturing capabilities">
        {capabilities.map(([label, body]) => (
          <section><h2>{label}</h2><p>{body}</p></section>
        ))}
      </section>
      <section class="quote" aria-labelledby="quote-title">
        <div>
          <h2 id="quote-title">What to send for a quote</h2>
          <p>A drawing, design or sample, overall dimensions, material and finish, first order quantity, expected reorders and target delivery date. Minimum quantities and lead times are evaluated for each project during quoting.</p>
          <a href={`${site.url}${quoteHref}`}>www.melcoed.com/request-a-quote/</a>
        </div>
        <div class="qr" aria-hidden="true" set:html={qrCode}></div>
      </section>
      <footer>
        <span>{fullAddress}</span>
        <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #e5dfd4; color: #201d19; font: 1rem/1.53 Arial, sans-serif; }
  a { color: inherit; text-underline-offset: .2em; }
  a:focus-visible { outline: 3px solid #9e442f; outline-offset: 3px; }
  main, .utility { max-width: 8.5in; margin: auto; }
  .utility { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .8rem; padding: 1rem; font-size: .9rem; }
  main { padding: clamp(1.1rem, 5vw, .48in); margin-bottom: 2rem; background: #faf7ef; }
  header, footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .8rem; }
  header { border-bottom: 3px solid #742b2b; padding-bottom: .14in; }
  p, h1, h2, figure { margin: 0; }
  .wordmark { white-space: nowrap; font: italic bold 2rem/1 Georgia, serif; color: #702828; letter-spacing: -.055em; }
  .wordmark span { display: inline; font-size: .63em; }
  .origin { color: #493f31; font-size: .87rem; }
  .origin span { display: block; }
  .intro { padding: .21in 0; }
  h1 { font: normal clamp(2.05rem, 5vw, 2.75rem)/1.04 Georgia, serif; letter-spacing: -.04em; }
  .intro p { margin-top: .12in; max-width: 68ch; }
  .pictures, .details { display: grid; gap: .2in; }
  .pictures { grid-template-columns: 1.4fr 1fr; gap: .12in; }
  figure { min-width: 0; }
  .pictures :global(img) { border-radius: 8px; display: block; width: 100%; height: 1.6in; object-fit: cover; }
  figcaption { padding-top: .04in; font-size: .78rem; color: #544a3d; }
  .details { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: .24in 0; }
  .details section { border-top: 1px solid #b8ab91; padding-top: .09in; }
  h2 { font: bold 1.27rem/1.2 Georgia, serif; color: #2a303a; }
  .details p, .quote p { margin-top: .055in; }
  .quote { border-radius: 8px; display: flex; gap: .25in; align-items: center; padding: .18in .2in; background: #202d3b; color: #fffaf0; }
  .quote h2 { color: inherit; }
  .quote a { font-weight: bold; font-size: .91em; display: inline-block; margin-top: .06in; }
  .qr { border-radius: 6px; width: .86in; height: .86in; background: white; padding: .04in; flex: none; }
  .qr :global(svg) { width: 100%; height: 100%; display: block; }
  footer { padding-top: .16in; font-size: .85rem; color: #443f35; }
  @media screen and (max-width: 35rem) {
    .details { grid-template-columns: 1fr; }
    .pictures :global(img) { height: 1.1in; }
    .qr { display: none; }
    .origin { font-size: .78rem; }
  }
  @media screen {
    main { border-radius: 8px; }
    .pictures { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pictures :global(img) { height: auto; aspect-ratio: 4 / 3; object-fit: contain; background: #fff; }
    .pictures figure:first-child :global(img) { background: #201d18; }
  }
  @page { size: letter; margin: 0; }
  @media print {
    :global(body) { background: #faf7ef; font: 10.5pt/1.43 Arial, sans-serif; }
    .utility { display: none; }
    main { margin: 0; width: 8.5in; padding: .39in .52in; }
    h1 { font-size: 30pt; }
    h2 { font-size: 14pt; }
    .details { gap: .2in .28in; }
    .quote, .pictures { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    footer { font-size: 9pt; }
  }
</style>
