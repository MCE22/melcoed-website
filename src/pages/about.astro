---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { site, quoteHref } from '../data/site';

const path = '/about/';
const breadcrumbs = [{ name: 'About', path }];

// Milestones: from the company history on the previous melcoed.com About page.
const milestones = [
  { year: String(site.foundingYear), text: 'Ed Sowa and his partners Mel and Cosmo start Mel-Co-Ed in a garage in Warwick, Rhode Island.' },
  { year: '1950s', text: 'The company begins making ornamental jewelry findings for women’s jewelry and men’s accessories.' },
  { year: '1964', text: 'Mel-Co-Ed moves to 381 Roosevelt Avenue in Pawtucket, where it still works today.' },
  { year: '1985', text: 'Ed’s son takes over, building up the tooling and the American-made custom and Open Line products.' },
  { year: '2022', text: 'Phil Sowa, Ed’s grandson, becomes the third generation to own and lead the company.' },
];

---
<BaseLayout
  title="About Mel-Co-Ed · A Rhode Island metal stamping shop since 1948"
  description="From a garage in Warwick to a stamping shop in Pawtucket, three generations of the Sowa family have made ornamental metalwork in Rhode Island."
  pageType="AboutPage"
  breadcrumbs={breadcrumbs}
>
  <PageHero title="Three generations in Rhode Island" lead="Mel-Co-Ed is a family-owned manufacturer of ornamental stampings, die-struck metalwork and precision components. Our tool room and presses share a roof on Roosevelt Avenue in Pawtucket." breadcrumbs={breadcrumbs} photo="about" variant="dark" />

  <section class="section">
    <div class="wrap story">
      <div>
        <h2>Mel, Cosmo and Ed</h2>
        <p class="lead">The name on the building comes from the three men who started the shop.</p>
        <p>Ed Sowa and his partners Mel and Cosmo began working out of a Warwick garage in 1948. By the 1950s they were stamping ornamental findings for Rhode Island’s jewelry trade. In 1964, they moved the presses to the Pawtucket building we use today.</p>
      </div>
      <ol class="timeline" aria-label="Company history">
        {milestones.map(m => <li><strong>{m.year}</strong><span>{m.text}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap">
      <div class="story">
        <div>
          <h2>The shop today</h2>
          <p>Phil Sowa joined the business in shipping and receiving in 2005. He later led sales and customer service, became vice president in 2015 and took over from his father in 2022. John Augustine has worked with the company's tooling and customers since 1977.</p>
        </div>
        <div>
          <h3>From sample to reorder</h3>
          <p>Product development, die making and stamping work together here. For a repeat order, the shop starts with the existing tooling and approved part, then reviews any changes to material, finish or fit.</p>
          <a class="text-link" href="/capabilities/product-development/">How we develop a part &rarr;</a>
        </div>
      </div>
      <div class="photos"><PhotoSlot slot="about" skip={1} max={4} todo="" /></div>
    </div>
  </section>
  <section class="section">
    <div class="wrap story">
      <div>
        <h2>Work with our Pawtucket shop</h2>
        <p>Explore <a href="/findings/">stock jewelry findings</a>, <a href="/products/">custom ornamental products</a> and <a href="/metal-stamping/">industrial parts stamped to print</a>.</p>
      </div>
      <div>
        <p>Send a drawing, artwork or a sample description, along with the quantity you need and any reorder plans.</p>
        <div class="btn-row"><a class="btn btn--primary" href={quoteHref}>Request a quote</a><a class="text-link" href="/contact/">Contact the shop</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .story { display:grid; gap:clamp(2rem,6vw,6rem); align-items:start; }
  .timeline { list-style:none; margin:0; padding:0; border-top:2px solid var(--brass); }
  .timeline li { display:grid; grid-template-columns:4.2rem minmax(0,1fr); gap:1rem; padding:.95rem 0; border-bottom:1px solid var(--rule); }
  .timeline strong { color:var(--oxblood); font-variant-numeric:tabular-nums; }
  .photos { margin-top:2.4rem; }
  @media(min-width:50rem){ .story { grid-template-columns:minmax(0,1fr) minmax(0,1.12fr); } }
</style>
