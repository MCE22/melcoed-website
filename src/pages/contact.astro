---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import building from '../assets/photos/building-sign.jpg';
import { shipping } from '../data/facts';
import { site, quoteHref, fullAddress, mapsUrl } from '../data/site';

const path = '/contact/';
const breadcrumbs = [{ name: 'Contact', path }];
---

<BaseLayout
  title="Contact Our Pawtucket Shop"
  description={`Contact Mel-Co-Ed, Inc. at ${fullAddress}. Call ${site.phone.display} or request a quote for custom metal stamping, badges, medallions and emblems.`}
  pageType="ContactPage"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    title="Contact Us"
    ribbon="Pawtucket, R.I."
    lead="Call the shop with a production question, email a drawing for review, or get directions for a pickup or visit."
    breadcrumbs={breadcrumbs}
  >
    <div class="btn-row hero-cta">
      <a class="btn btn--primary" href={quoteHref}>Request a quote</a>
      <a class="text-link" href={`tel:${site.phone.e164}`}>or call {site.phone.display}</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="reach-h">
    <div class="wrap contact">
      <div class="contact__details">
        <h2 id="reach-h" class="visually-hidden">How to reach us</h2>

        <div class="card info">
          <h3>Phone</h3>
          <p class="info__big"><a href={`tel:${site.phone.e164}`}>{site.phone.display}</a></p>
        </div>

        {
          site.email && (
            <div class="card info">
              <h3>Email</h3>
              <p class="info__big">
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </p>
              <p class="info__note">Quotes, drawings and general questions.</p>
            </div>
          )
        }

        <div class="card info">
          <h3>Address</h3>
          <address>
            {site.name}<br />
            {site.address.street}<br />
            {site.address.city}, {site.address.regionName} {site.address.postalCode}
          </address>
          <p><a href={mapsUrl} rel="noopener" target="_blank">Get directions &rarr;</a></p>
        </div>

        <div class="card info">
          <h3>Hours</h3>
          <p>{site.hoursText.map((h, i) => <>{i > 0 && <br />}{h}</>)}</p>
        </div>

        <div class="card info">
          <h3>Shipping &amp; pickup</h3>
          <p>{shipping.carriers}.<br />{shipping.local}.<br />{shipping.pickup}.</p>
        </div>
      </div>

      <figure class="map">
        <Image src={building} alt="Mel-Co-Ed’s sign on the front of its Pawtucket building" widths={[400, 680, 960]} sizes="(min-width: 56rem) 50vw, 90vw" width={900} format="webp" loading="lazy" />
        <figcaption><a href={mapsUrl}>Directions to {fullAddress} &rarr;</a></figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 56rem) {
    .contact {
      grid-template-columns: 1fr 1.25fr;
      gap: 3rem;
    }
    .map {
      position: sticky;
      top: calc(var(--header-live, var(--header-h)) + 2rem);
    }
  }
  .contact__details {
    display: grid;
    gap: 1rem;
  }
  .info {
    padding: 1.25rem 1.4rem;
  }
  .info h3 {
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cherry);
  }
  .info p,
  .info address {
    margin: 0;
  }
  .info address {
    font-style: normal;
    margin-bottom: 0.5rem;
    color: var(--ink);
  }
  .info__big {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 5vw, 1.7rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .info__big a {
    color: var(--navy);
    text-decoration: none;
  }
  .info__big a:hover {
    color: var(--cherry);
  }
  .info__note {
    margin-top: 0.35rem !important;
    color: var(--ink-600);
    font-size: 0.95rem;
  }


  .map {
    margin: 0;
    padding: 0;
    border-radius: var(--radius-lg);
    background: var(--paper);
    border: 1px solid var(--chrome);
    box-shadow: var(--shadow);
  }
  .map img {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
    border-radius: var(--radius);
    background: var(--cream-100);
  }
  .map figcaption {
    padding: 1rem;
    font-size: 0.85rem;
    color: var(--ink-600);
  }
</style>
