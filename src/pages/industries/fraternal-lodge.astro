---
import ResourceLinks from '../../components/ResourceLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import Todo from '../../components/Todo.astro';
import { materialsLine, finishesLine, minimumLine, leadTimeLine, dieStrikingLine, ordering, reproductions, attachments } from '../../data/facts';
import PhotoSlot from '../../components/PhotoSlot.astro';
import ConfidentialBand from '../../components/ConfidentialBand.astro';
import { site, quoteHref } from '../../data/site';
import { faqPageNode, type Faq } from '../../lib/schema';

const path = '/industries/fraternal-lodge/';
const breadcrumbs = [
  { name: 'Industries', path: '/industries/' },
  { name: 'Fraternal & Lodge', path },
];
const quote = `${quoteHref}?type=fraternal`;

const products = [
  {
    title: 'Lapel pins',
    body: 'Your emblem, name and number, die-struck for crisp lettering that stays legible at lapel size.',
  },
  {
    title: 'Emblems & insignia',
    body: 'Stamped emblems for regalia, aprons, collars, hats and banners, supplied finished or as raw stampings for your finisher.',
  },
  {
    title: 'Past Master & officer jewels',
    body: 'Past Master and officer jewels, struck from steel dies and finished to your standard.',
  },
  {
    title: 'Anniversary medallions',
    body: 'Two-sided medallions for an organization’s anniversary or milestone.',
  },
  {
    title: 'Service & membership pins',
    body: 'Years-of-service pins and recognition pieces, run in matched sets so every year in the program looks the same.',
  },
];

const audiences = [
  'Lapel pins and emblems',
  'Past Master and officer jewels',
  'Anniversary medallions',
  'Service and membership pins',
];

const faqs: Faq[] = [
  {
    q: 'Can you make custom lodge lapel pins?',
    a: 'Yes. We can strike custom lapel pins from your artwork: your emblem, name and number, founding date or anniversary year. Pins are die-struck from steel tooling for sharp detail at small sizes.',
  },
  {
    q: 'What is the difference between die-struck and die-cast pins?',
    a: 'Die-struck pins are stamped from sheet metal under a press, which gives crisp, sharp detail and fine lettering. Die-cast pins are made by pouring molten metal into a mold, which suits pieces with deep 3D shapes or open cut-outs. For most lodge emblems with lettering and fine lines, die-struck gives the cleaner result.',
  },
  {
    q: 'Can you reproduce an old lodge pin or emblem from a sample?',
    a: `Yes. ${reproductions} Send us the sample and we will tell you what it takes to make new tooling that matches the original.`,
  },
  {
    q: 'Can you make emblems that belong to a trademarked fraternal organization?',
    a: "Some fraternal organizations control their emblems through trademark licensing. For those emblems we need your organization's written authorization, or the order should come through a licensed supplier, before we strike.",
  },
  {
    q: 'What is the minimum order for lodge pins?',
    a: `Our minimum is ${ordering.minimum}; smaller runs are available at a higher price. ${ordering.noMinimum} Lead time is typically ${ordering.leadTime}.`,
  },
  {
    q: 'Can you work with regalia companies and distributors?',
    a: 'Yes. We can supply stamped emblems, raw stampings and finished pieces made to a supplier’s designs.',
  },
];
---

<BaseLayout
  title="Fraternal & Lodge Emblems, Lapel Pins & Jewels"
  description="Die-struck lapel pins, emblems, jewels and anniversary medallions of the kind fraternal organizations use, made by Mel-Co-Ed in Pawtucket, RI since 1948. Custom designs and reproductions."
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
  schema={[faqPageNode(path, faqs)]}
>
  <PageHero
    title="Fraternal & Lodge Emblems"
    accent="made to your design"
    ribbon="Pins · Emblems · Jewels"
    lead="Lapel pins, emblems, jewels and anniversary medallions of the kind fraternal organizations use, die-struck in Pawtucket, Rhode Island."
    breadcrumbs={breadcrumbs}
  
    photo="industries-fraternal"
    photoTodo="Hero photo: house-sample pins or emblems on dark wood"
  >
    <div class="btn-row hero-cta">
      <a class="btn btn--primary" href={quote}>Quote lodge emblems</a>
      <a class="text-link" href={`tel:${site.phone.e164}`}>or call {site.phone.display}</a>
    </div>
  </PageHero>

  <!-- What we make -->
  <section class="section" aria-labelledby="make-h">
    <div class="wrap">
      <div class="section-head">
        <span class="ribbon ribbon--ink">What we make</span>
        <h2 id="make-h">Emblems that outlast the meeting</h2>
        <p class="lead">
          Fraternal pieces get worn for decades and handed down. They're struck from steel dies, so the emblem, number
          and lettering stay crisp.
        </p>
      </div>
      <div class="grid grid--2">
        {
          products.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
      <div class="ind-photos">
        <PhotoSlot slot="industries-fraternal" skip={1} todo="Photos: lodge lapel pins, emblems and anniversary medallions MCE has made (3–6 images; get the lodge’s OK before showing its emblem)." />
      </div>
    </div>
  </section>

  <ConfidentialBand quote={quote} />

  <!-- Who + specs -->
  <section class="section section--ink" aria-labelledby="specs-h">
    <div class="wrap split">
      <div>
        <span class="ribbon ribbon--cream">Who we work with</span>
        <h2 id="specs-h">What we can make</h2>
        <ul class="audience">
          {audiences.map((a) => <li>{a}</li>)}
        </ul>
        <p class="note">
          Some fraternal organizations license their emblems. If yours does, tell us when you request a quote.
        </p>
      </div>
      <dl class="specs">
        <div><dt>Process</dt><dd>Die-struck from steel tooling</dd></div>
        <div><dt>Size</dt><dd>{dieStrikingLine}</dd></div>
        <div><dt>Metals</dt><dd>{materialsLine}</dd></div>
        <div><dt>Finishes</dt><dd>{finishesLine}</dd></div>
        <div><dt>Attachments</dt><dd>{attachments}</dd></div>
        <div><dt>Minimum order</dt><dd>{minimumLine}</dd></div>
        <div><dt>Lead time</dt><dd>{leadTimeLine}</dd></div>
      </dl>
    </div>
  </section>

  <!-- How ordering works -->
  <section class="section" aria-labelledby="order-h">
    <div class="wrap">
      <div class="section-head">
        <span class="ribbon ribbon--ink">Ordering</span>
        <h2 id="order-h">From artwork to finished pin</h2>
      </div>
      <ol class="steps">
        <li class="step">
          <span class="step__n">01</span>
          <h3>Send your artwork</h3>
          <p>A seal, an old pin, a sketch or a scan. Include the name, number and dates you want on the piece.</p>
        </li>
        <li class="step">
          <span class="step__n">02</span>
          <h3>Approve the proof</h3>
          <p>We prepare the design for striking and send it back for you to approve.</p>
        </li>
        <li class="step">
          <span class="step__n">03</span>
          <h3>Tooling &amp; strike</h3>
          <p>Steel dies are cut and parts are struck. You own the die and we store it free, so reorders don't start over.</p>
        </li>
        <li class="step">
          <span class="step__n">04</span>
          <h3>Finish &amp; ship</h3>
          <p>Pieces are finished, fitted with their backs and shipped to you or your supplier.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--cream" aria-labelledby="faq-h">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <h2 id="faq-h">Lodge emblem FAQ</h2>
        <a class="btn btn--primary" href={quote}>Request a quote</a>
      </div>
      <FaqList faqs={faqs} />
    </div>
  </section>
  <ResourceLinks path="/industries/fraternal-lodge/" custom />
</BaseLayout>

<style>
  .ind-photos {
    margin-top: 2rem;
  }
  .note {
    color: var(--cream-200);
    font-size: 0.95rem;
  }
</style>