---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { site, quoteHref } from '../../data/site';
import Icon from '../../components/Icon.astro';
import { industries } from '../../data/industries';
import { isLive } from '../../lib/routes';

const path = '/industries/';
const breadcrumbs = [{ name: 'Industries', path }];
const live = industries.filter((i) => isLive(i.href));

// ItemList of the industry pages that exist, so search engines see the hub's structure.
const itemList = {
  '@type': 'ItemList',
  name: 'Industries served by Mel-Co-Ed, Inc.',
  itemListElement: live.map((i, n) => ({
    '@type': 'ListItem',
    position: n + 1,
    name: i.name,
    url: new URL(i.href, site.url).toString(),
  })),
};
---

<BaseLayout
  title="Metal Stamping for Every Industry: OEM, Hardware, Electrical, Jewelry & More"
  description="Mel-Co-Ed provides metal stamping and die striking for OEM and industrial, hardware, electrical, jewelry, awards, public safety, fraternal, corporate, religious and sports customers. Pawtucket, RI since 1948."
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
  schema={[itemList]}
  hideFooterCta
>
  <PageHero
    title="Metal stamping"
    accent="for every industry"
    ribbon="Industries"
    lead="Manufacturers, jewelers, agencies and lodges come to us for the same thing: parts stamped right, from tooling we build in-house."
    breadcrumbs={breadcrumbs}
    photo="industries"
    photoTodo="Industries hero photo: finished work across industries"
  />

  <section class="section">
    <div class="wrap">
      <ul class="inds">
        {
          industries.map((i) => (
            <li class="ind">
              <Icon name={i.icon} size={32} />
              <h2 class="ind__h">{isLive(i.href) ? <a href={i.href}>{i.name}</a> : i.name}</h2>
              <p>{i.summary}</p>
              {i.related && isLive(i.related.href) && (
                <a class="ind__related" href={i.related.href}>
                  {i.related.label} &rarr;
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap not-listed">
      <div>
        <h2>Not listed? <em>If it's stamped metal, ask.</em></h2>
        <p class="lead">Send a print, a sketch or a sample and we'll tell you whether it's a fit.</p>
      </div>
      <a class="btn btn--primary" href={quoteHref}>Request a Quote <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .inds {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 40rem) {
    .inds {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 3rem;
    }
  }
  .ind {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.25rem;
    align-content: start;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .ind :global(.icon) {
    grid-row: span 3;
    color: var(--brass);
  }
  .ind__h {
    margin: 0 0 0.35rem;
    font-size: 1.35rem;
    line-height: 1.1;
  }
  .ind__h a {
    color: var(--ink);
    text-decoration: none;
  }
  .ind__h a::after {
    content: ' →';
    color: var(--oxblood);
  }
  .ind__h a:hover {
    color: var(--oxblood);
  }
  .ind p {
    margin: 0;
    color: var(--ink-600);
  }
  .ind__related {
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .not-listed {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .not-listed {
      grid-template-columns: 1.5fr auto;
      gap: 3rem;
    }
  }
</style>
